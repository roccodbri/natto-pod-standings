{%- comment -%}
  Dark green footer: leaf logo + wordmark, hairline rule, Menu / Policies
  columns, newsletter block, copyright + supplement disclaimer.
{%- endcomment -%}
<footer class="lpft">
  <div class="lp-wrap">
    <div class="lpft-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C7.5 6 5.5 9.5 5.5 13.5A6.5 6.5 0 0 0 12 20a6.5 6.5 0 0 0 6.5-6.5C18.5 9.5 16.5 6 12 2z"/><path d="M12 6.5V20M12 11l3.2-2.4M12 14.5l-3.2-2.4"/></svg>
      <span>{{ section.settings.brand | default: 'PINEMOOR' }}</span>
    </div>
    <div class="lpft-rule" aria-hidden="true"></div>

    <div class="lpft-cols">
      <div class="lpft-col">
        <h4>Menu</h4>
        <ul>
          <li><a href="{{ routes.root_url }}">Shop</a></li>
          <li><a href="mailto:hello@pinemoor.com">Contact</a></li>
        </ul>
      </div>
      <div class="lpft-col">
        <h4>Policies</h4>
        <ul>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="lpft-news">
      <h3>Let's Stay Connected</h3>
      <p>Be first to know about seasonal tick alerts and special savings.</p>
      <form class="lpft-form" onsubmit="event.preventDefault();var b=this.querySelector('button');b.textContent='Thank you!';b.disabled=true;this.querySelector('input').value='';setTimeout(function(){b.textContent='Join';b.disabled=false;},3000);">
        <input type="email" placeholder="Enter your email" required aria-label="Email address">
        <button type="submit">Join</button>
      </form>
    </div>

    <div class="lpft-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} Pinemoor. All rights reserved.</p>
      <p class="lpft-disc">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Tick exposure cannot be eliminated entirely; always perform tick checks after time outdoors.</p>
    </div>
  </div>
</footer>

<style>
.lpft{background:var(--lpg-dark);color:#fff;padding:48px 0 34px;}
.lpft-logo{display:flex;align-items:center;gap:10px;}
.lpft-logo svg{width:36px;height:36px;}
.lpft-logo span{font-family:var(--lp-head);font-weight:500;font-size:30px;letter-spacing:.18em;color:#fff;}
.lpft-rule{height:1px;background:rgba(255,255,255,.35);margin:26px 0 30px;}
.lpft-cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.lpft-col h4{font-family:var(--lp-head);font-weight:500;font-size:26px;color:#fff;margin-bottom:18px;}
.lpft-col ul{list-style:none;display:flex;flex-direction:column;gap:16px;}
.lpft-col a{font-family:var(--lp-body);font-size:17px;color:rgba(255,255,255,.92);}
.lpft-news{margin-top:40px;}
.lpft-news h3{font-family:var(--lp-head);font-weight:500;font-size:26px;color:#fff;}
.lpft-news p{font-family:var(--lp-body);font-size:16px;line-height:1.5;color:rgba(255,255,255,.85);margin-top:10px;}
.lpft-form{display:flex;gap:10px;margin-top:16px;}
.lpft-form input{flex:1;min-width:0;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.35);border-radius:8px;
  padding:14px 14px;font-family:var(--lp-body);font-size:15px;color:#fff;}
.lpft-form input::placeholder{color:rgba(255,255,255,.55);}
.lpft-form button{background:var(--lp-mint);color:var(--lpg-deep);border-radius:8px;padding:14px 26px;
  font-family:var(--lp-body);font-weight:700;font-size:15px;}
.lpft-bottom{margin-top:38px;border-top:1px solid rgba(255,255,255,.2);padding-top:20px;}
.lpft-bottom p{font-family:var(--lp-body);font-size:13.5px;color:rgba(255,255,255,.75);}
.lpft-disc{margin-top:12px;font-size:11.5px;line-height:1.5;color:rgba(255,255,255,.5)!important;}
</style>

{% schema %}
{
  "name": "LP Footer",
  "settings": [
    {"type":"text","id":"brand","label":"Brand wordmark","default":"PINEMOOR"}
  ]
}
{% endschema %}
