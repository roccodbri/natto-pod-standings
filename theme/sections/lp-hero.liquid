{%- liquid
  assign variant_1 = section.settings.variant_id_1 | default: '52810262577333'
  assign variant_2 = section.settings.variant_id_2 | default: '52810262610101'
  assign variant_3 = section.settings.variant_id_3 | default: '52810262642869'
  assign hero_product = all_products[section.settings.product]
  assign use_product_images = false
  if hero_product and hero_product.images.size > 0
    assign use_product_images = true
  endif
  assign fb1 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoorproduct1_1highquality.png?v=1780285911&width=900'
  assign fb2 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/lone_star_tick_drops.png?v=1779163464&width=900'
  assign fb3 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_3_bottles_no_droppers.png?v=1780325112&width=900'
  assign fb4 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_6_bottles_lined_up.png?v=1780325063&width=900'
  assign fb5 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260708_005146_a373486f-5728-4345-bef3-e9921f2ba859.png?v=1783998646&width=900'
-%}

<section class="lhr" id="lp-hero">
  <div class="v3-wrap">

    <h1 class="lhr-title">Pinemoor&reg; Tick Protection Drops</h1>
    <p class="lhr-sub">Repel ticks before they ever bite, with a simple daily herbal drop ritual &mdash; no DEET, no sprays.</p>

    <!-- benefit chips -->
    <div class="lhr-chips">
      <span class="lhr-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> 24-Hour Protection</span>
      <span class="lhr-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/></svg> No DEET</span>
      <span class="lhr-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg> Kid-Approved</span>
    </div>

    <!-- rating row -->
    <div class="lhr-rating">
      <span class="v3-stars" aria-hidden="true">
        {%- for i in (1..5) -%}<svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z"/></svg>{%- endfor -%}
      </span>
      <span class="lhr-avatars">
        <img src="{{ 'pm-shot-dropper.webp' | asset_url }}" alt="" loading="lazy" decoding="async" width="22" height="22">
        <img src="{{ 'pm-samanthamorgan-89531.webp' | asset_url }}" alt="" loading="lazy" decoding="async" width="22" height="22">
        <img src="{{ 'pm-shot-held.webp' | asset_url }}" alt="" loading="lazy" decoding="async" width="22" height="22">
      </span>
      <span class="lhr-rating-txt">Rated 4.8 Excellent&apos; | 1,206+ Reviews</span>
    </div>

    <!-- gallery: big stage left, vertical thumb rail right -->
    <div class="lhr-gallery">
      <div class="lhr-stage" id="lhrStage">
        {%- if use_product_images -%}
          {%- for img in hero_product.images limit: 6 -%}
          <img class="lhr-slide{% if forloop.first %} active{% endif %}" src="{{ img | image_url: width: 900 }}" alt="{{ img.alt | escape | default: 'Pinemoor Tick Protection Drops' }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %} decoding="async" width="{{ img.width }}" height="{{ img.height }}">
          {%- endfor -%}
        {%- else -%}
          <img class="lhr-slide active" src="{{ fb1 }}" alt="Pinemoor Tick Protection Drops bottle" loading="eager" fetchpriority="high" decoding="async">
          <img class="lhr-slide" src="{{ fb2 }}" alt="Pinemoor herbal drops benefits" loading="lazy" decoding="async">
          <img class="lhr-slide" src="{{ fb3 }}" alt="Inside every Pinemoor drop" loading="lazy" decoding="async">
          <img class="lhr-slide" src="{{ fb4 }}" alt="Pinemoor customer results" loading="lazy" decoding="async">
          <img class="lhr-slide" src="{{ fb5 }}" alt="Pinemoor supplement facts" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
      <div class="lhr-rail" id="lhrRail">
        {%- if use_product_images -%}
          {%- for img in hero_product.images limit: 6 -%}
          <button type="button" class="lhr-thumb{% if forloop.first %} active{% endif %}" onclick="lhrGo({{ forloop.index0 }})" aria-label="View image {{ forloop.index }}"><img src="{{ img | image_url: width: 160 }}" alt="" loading="lazy" decoding="async" width="58" height="72"></button>
          {%- endfor -%}
        {%- else -%}
          {%- assign fbs = '' -%}
          <button type="button" class="lhr-thumb active" onclick="lhrGo(0)" aria-label="Image 1"><img src="{{ fb1 }}" alt="" loading="lazy" decoding="async" width="58" height="72"></button>
          <button type="button" class="lhr-thumb" onclick="lhrGo(1)" aria-label="Image 2"><img src="{{ fb2 }}" alt="" loading="lazy" decoding="async" width="58" height="72"></button>
          <button type="button" class="lhr-thumb" onclick="lhrGo(2)" aria-label="Image 3"><img src="{{ fb3 }}" alt="" loading="lazy" decoding="async" width="58" height="72"></button>
          <button type="button" class="lhr-thumb" onclick="lhrGo(3)" aria-label="Image 4"><img src="{{ fb4 }}" alt="" loading="lazy" decoding="async" width="58" height="72"></button>
          <button type="button" class="lhr-thumb" onclick="lhrGo(4)" aria-label="Image 5"><img src="{{ fb5 }}" alt="" loading="lazy" decoding="async" width="58" height="72"></button>
        {%- endif -%}
      </div>
    </div>

    <!-- sold bar + nutrition button -->
    <div class="lhr-soldrow">
      <div class="lhr-sold">
        <span class="lhr-sold-bar"><span class="lhr-sold-fill" style="width:93%"></span></span>
        <span class="lhr-sold-txt">93% Sold</span>
      </div>
      <button type="button" class="lhr-nutbtn" onclick="lhrNut(true)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/></svg>
        See What&rsquo;s Inside
      </button>
    </div>

    <!-- icon benefit rows -->
    <div class="lhr-bens">
      <div class="lhr-ben">
        <span class="lhr-ben-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <div class="lhr-ben-txt"><b>Repels ticks before they bite</b><span>One dropper a day changes the scent ticks hunt by.</span></div>
      </div>
      <div class="lhr-ben">
        <span class="lhr-ben-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <div class="lhr-ben-txt"><b>24-hour whole-body coverage</b><span>No sprays, no missed spots, no reapplying.</span></div>
      </div>
      <div class="lhr-ben">
        <span class="lhr-ben-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"/><circle cx="17.5" cy="9.5" r="2.5"/><path d="M16 15.4c2.8.2 5 1.9 5 4.6"/></svg></span>
        <div class="lhr-ben-txt"><b>Safe for the whole family</b><span>Maple syrup&ndash;flavored, kid-approved, no DEET.</span></div>
      </div>
    </div>

    <div class="lhr-hr"></div>

    <!-- offers -->
    {%- capture lhr_offers -%}
    <div class="lhr-offers" id="lhrOffers">
      <label class="lhr-opt" data-variant="{{ variant_1 }}" data-total="44.99" data-strike="49.99">
        <img class="lhr-opt-img" src="https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260713_233510_2fd30a75-bcc7-4fe8-a2b9-d92c9085bdba.png?v=1783998610&width=240" alt="Pinemoor single bottle" loading="lazy" decoding="async" width="52" height="52">
        <div class="lhr-opt-main">
          <b>Buy One</b>
          <i>$44.99 per Bottle</i>
        </div>
        <div class="lhr-opt-right">
          <b>$44.99</b>
          <s>$49.99</s>
        </div>
      </label>
      <label class="lhr-opt is-active" data-variant="{{ variant_2 }}" data-total="99.99" data-strike="134.97">
        <span class="lhr-opt-badge">Most Popular</span>
        <img class="lhr-opt-img" src="https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260708_005146_a373486f-5728-4345-bef3-e9921f2ba859.png?v=1783998646&width=240" alt="Pinemoor 3 bottles" loading="lazy" decoding="async" width="52" height="52">
        <div class="lhr-opt-main">
          <b>Buy 2, Get 1 FREE</b>
          <i>$33.33 per Bottle</i>
        </div>
        <div class="lhr-opt-right">
          <b>$99.99</b>
          <s>$134.97</s>
        </div>
      </label>
      <label class="lhr-opt" data-variant="{{ variant_3 }}" data-total="129.99" data-strike="269.94">
        <span class="lhr-opt-badge">Free Shipping</span>
        <img class="lhr-opt-img" src="https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260714_025548_3e90ab15-b2fa-44f2-9aff-b461f6071bc9.png?v=1783998595&width=240" alt="Pinemoor 6 bottle family bundle" loading="lazy" decoding="async" width="52" height="52">
        <div class="lhr-opt-main">
          <b>Buy 3, Get 3 FREE</b>
          <i>$21.66 per Bottle</i>
        </div>
        <div class="lhr-opt-right">
          <b>$129.99</b>
          <s>$269.94</s>
        </div>
      </label>
    </div>
    {%- endcapture -%}

    {%- capture lhr_footer -%}
    <div class="lhr-ship"><span class="lhr-ship-dot"></span> Ready to ship - arrives by <u id="lhrShipDate">&mdash;</u></div>
    <button type="button" class="v3-atc" onclick="lhrAtc()">
      <span class="v3-atc-main">Add To Cart &ndash; <span id="lhrAtcPrice">$99.99</span> <span class="v3-atc-strike" id="lhrAtcStrike">$134.97</span></span>
      <span class="v3-atc-sub"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm-1.5 15.5l-3.8-3.8 1.4-1.4 2.4 2.4 5.4-5.4 1.4 1.4-6.8 6.8z"/></svg> Lifetime Money-Back Guarantee</span>
    </button>
    <div class="lhr-refill">
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="5" width="14" height="11" rx="1.5"/><path d="M15 9h4l3 3v4h-7V9z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg> Ships Free From The USA</span>
      <em>|</em>
      <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Lifetime Guarantee</span>
    </div>
    <div class="lhr-pay">
      {%- assign pay_icons = "visa,master,paypal,shopify_pay,apple_pay,google_pay" | split: "," -%}
      {%- for type in pay_icons -%}{{ type | payment_type_svg_tag: class: 'lhr-pay-icon' }}{%- endfor -%}
    </div>
    {%- endcapture -%}

    {%- if hero_product -%}
      {% form 'product', hero_product, id: 'lp-product-form' %}
        <input type="hidden" name="id" id="lhr-variant-input" value="{{ variant_2 }}">
        <input type="hidden" name="quantity" value="1">
        {{ lhr_offers }}
        {{ lhr_footer }}
      {% endform %}
    {%- else -%}
      {{ lhr_offers }}
      {{ lhr_footer }}
    {%- endif -%}

  </div>

  <!-- nutrition popup -->
  <div class="lhr-nut" id="lhrNutModal" role="dialog" aria-modal="true" aria-label="Nutritional information" style="display:none;">
    <div class="lhr-nut-bg" onclick="lhrNut(false)"></div>
    <div class="lhr-nut-card">
      <button type="button" class="lhr-nut-x" onclick="lhrNut(false)" aria-label="Close">&#10005;</button>
      <h3>Nutritional Information</h3>
      <div class="lhr-nut-panel">
        <div class="lhr-nut-head">Supplement Facts</div>
        <div class="lhr-nut-row lhr-nut-row--meta"><span>Serving Size: 1 Full Dropper (1 mL)</span><span>Servings: ~30</span></div>
        <div class="lhr-nut-row lhr-nut-row--th"><span>Proprietary Herbal Blend</span><span>Amount</span></div>
        <div class="lhr-nut-row"><span>Oregano Extract (carvacrol)</span><span>&#10003;</span></div>
        <div class="lhr-nut-row"><span>Thyme (thymol)</span><span>&#10003;</span></div>
        <div class="lhr-nut-row"><span>Garlic Extract</span><span>&#10003;</span></div>
        <div class="lhr-nut-row"><span>Soursop</span><span>&#10003;</span></div>
        <div class="lhr-nut-row"><span>Caraway Seed</span><span>&#10003;</span></div>
        <div class="lhr-nut-row"><span>Pau D&rsquo;Arco</span><span>&#10003;</span></div>
        <div class="lhr-nut-foot">Other ingredients: pure maple syrup, distilled water. No DEET, no permethrin, no artificial colors or preservatives. Gluten-free &middot; Non-GMO.</div>
      </div>
      <p class="lhr-nut-note">Take one full dropper daily with water, coffee, or juice. Crafted for consistent, everyday use by the whole family.</p>
    </div>
  </div>
</section>

<style>
  .lhr{background:#fff;padding:16px 0 4px;}
  .lhr-title{font-family:var(--v3-head);font-weight:600;font-size:30px;line-height:1.14;letter-spacing:-.02em;margin-bottom:10px;}
  .lhr-sub{font-size:16px;line-height:1.42;color:var(--v3-ink);font-weight:500;margin-bottom:13px;}
  .lhr-chips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px;}
  .lhr-chip{display:inline-flex;align-items:center;gap:5px;background:var(--v3-tint);border:1px solid var(--v3-line);
    border-radius:50px;padding:6px 11px;font-size:12px;font-weight:600;color:var(--v3-ink);}
  .lhr-chip svg{width:14px;height:14px;color:var(--v3-green);}
  .lhr-rating{display:flex;align-items:center;gap:7px;margin-bottom:14px;flex-wrap:wrap;}
  .lhr-avatars{display:inline-flex;}
  .lhr-avatars img{width:22px;height:22px;border-radius:50%;object-fit:cover;border:1.5px solid #fff;margin-left:-7px;}
  .lhr-avatars img:first-child{margin-left:0;}
  .lhr-rating-txt{font-size:12.5px;font-weight:600;color:var(--v3-ink);}

  /* gallery */
  .lhr-gallery{display:flex;gap:8px;margin-bottom:14px;}
  .lhr-stage{flex:1;min-width:0;border-radius:var(--v3-radius);overflow:hidden;background:var(--v3-tint);position:relative;aspect-ratio:1/1.03;}
  .lhr-slide{display:none;width:100%;height:100%;object-fit:cover;}
  .lhr-slide.active{display:block;}
  .lhr-rail{flex:none;width:62px;display:flex;flex-direction:column;gap:7px;overflow-y:auto;scrollbar-width:none;}
  .lhr-rail::-webkit-scrollbar{display:none;}
  .lhr-thumb{flex:none;width:62px;height:76px;border-radius:9px;overflow:hidden;border:1.6px solid transparent;
    background:var(--v3-tint);padding:0;transition:border-color .15s;}
  .lhr-thumb.active{border-color:var(--v3-green);}
  .lhr-thumb img{width:100%;height:100%;object-fit:cover;}

  /* sold row */
  .lhr-soldrow{display:flex;gap:9px;margin-bottom:16px;}
  .lhr-sold{flex:1;display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--v3-line-soft);
    border-radius:12px;padding:12px 14px;box-shadow:0 1px 5px rgba(17,17,17,.06);}
  .lhr-sold-bar{flex:1;height:9px;border-radius:6px;background:rgba(185,20,20,.12);overflow:hidden;}
  .lhr-sold-fill{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,#D73A3A,var(--v3-red));}
  .lhr-sold-txt{font-size:13px;font-weight:700;color:var(--v3-red);white-space:nowrap;}
  .lhr-nutbtn{flex:none;display:inline-flex;align-items:center;gap:7px;background:var(--v3-dark);color:#fff;
    border-radius:12px;padding:12px 15px;font-size:13px;font-weight:600;}
  .lhr-nutbtn svg{width:15px;height:15px;color:var(--v3-mint);}

  /* benefit rows */
  .lhr-bens{display:flex;flex-direction:column;gap:15px;margin-bottom:18px;}
  .lhr-ben{display:flex;gap:11px;align-items:flex-start;}
  .lhr-ben-ic{flex:none;width:26px;height:26px;color:var(--v3-green);}
  .lhr-ben-ic svg{width:100%;height:100%;}
  .lhr-ben-txt{display:flex;flex-direction:column;gap:2px;}
  .lhr-ben-txt b{font-size:14.5px;font-weight:700;color:var(--v3-ink);line-height:1.25;}
  .lhr-ben-txt span{font-size:13px;color:var(--v3-mut);line-height:1.35;}
  .lhr-hr{height:1px;background:rgba(17,17,17,.12);margin:0 0 20px;}

  /* offers */
  .lhr-offers{display:flex;flex-direction:column;gap:13px;margin-bottom:14px;}
  .lhr-opt{position:relative;display:flex;align-items:center;gap:11px;background:#fff;border:1.5px solid var(--v3-line-soft);
    border-radius:12px;padding:13px 14px;cursor:pointer;transition:border-color .15s,background .15s;}
  .lhr-opt.is-active{border-color:var(--v3-dark);border-width:2px;background:var(--v3-tint);}
  .lhr-opt-badge{position:absolute;top:-12px;right:14px;background:var(--v3-dark);color:#fff;border-radius:50px;
    padding:4px 13px;font-size:11.5px;font-weight:600;}
  .lhr-opt-img{flex:none;width:52px;height:52px;object-fit:contain;}
  .lhr-opt.is-active .lhr-opt-img{transform:scale(1.15);}
  .lhr-opt-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;}
  .lhr-opt-main b{font-size:15px;font-weight:700;color:var(--v3-ink);}
  .lhr-opt-main i{font-size:12.5px;font-style:italic;font-weight:600;color:var(--v3-darker);}
  .lhr-opt-right{flex:none;text-align:right;display:flex;flex-direction:column;gap:2px;}
  .lhr-opt-right b{font-size:15.5px;font-weight:700;color:var(--v3-ink);}
  .lhr-opt-right s{font-size:13px;color:var(--v3-mut);}

  /* ship + atc */
  .lhr-ship{display:flex;align-items:center;justify-content:center;gap:7px;font-size:13.5px;font-weight:600;
    color:var(--v3-ink);margin-bottom:11px;}
  .lhr-ship-dot{width:9px;height:9px;border-radius:50%;background:var(--v3-green);box-shadow:0 0 0 3px rgba(25,155,98,.2);}
  .lhr-ship u{text-underline-offset:2px;}
  .lhr-refill{display:flex;align-items:center;justify-content:center;gap:10px;margin:13px 0 14px;
    font-size:12.5px;font-weight:600;color:var(--v3-ink);}
  .lhr-refill em{font-style:normal;color:rgba(17,17,17,.3);}
  .lhr-refill span{display:inline-flex;align-items:center;gap:6px;}
  .lhr-refill svg{width:15px;height:15px;color:var(--v3-ink);}
  .lhr-pay{display:flex;justify-content:center;gap:5px;margin-bottom:16px;}
  .lhr-pay-icon{width:38px;height:24px;}

  /* nutrition modal */
  .lhr-nut{position:fixed;inset:0;z-index:90;display:flex;align-items:center;justify-content:center;padding:18px;}
  .lhr-nut-bg{position:absolute;inset:0;background:rgba(6,32,20,.55);}
  .lhr-nut-card{position:relative;background:#fff;border-radius:16px;max-width:400px;width:100%;max-height:82vh;
    overflow-y:auto;padding:22px 18px;}
  .lhr-nut-x{position:absolute;top:12px;right:14px;font-size:15px;color:var(--v3-mut);}
  .lhr-nut-card h3{font-family:var(--v3-head);font-weight:600;font-size:20px;margin-bottom:14px;}
  .lhr-nut-panel{border:2px solid var(--v3-ink);border-radius:8px;overflow:hidden;}
  .lhr-nut-head{font-weight:800;font-size:19px;padding:9px 12px;border-bottom:6px solid var(--v3-ink);}
  .lhr-nut-row{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;font-size:12.5px;border-bottom:1px solid rgba(17,17,17,.2);}
  .lhr-nut-row--meta{font-weight:600;}
  .lhr-nut-row--th{font-weight:700;border-bottom:3px solid var(--v3-ink);}
  .lhr-nut-foot{padding:9px 12px;font-size:11.5px;color:var(--v3-body);line-height:1.45;}
  .lhr-nut-note{font-size:12.5px;color:var(--v3-mut);margin-top:12px;line-height:1.45;}
</style>

<script>
(function(){
  /* gallery */
  var slides=[].slice.call(document.querySelectorAll('#lhrStage .lhr-slide'));
  var thumbs=[].slice.call(document.querySelectorAll('#lhrRail .lhr-thumb'));
  var cur=0;
  window.lhrGo=function(n){
    if(!slides.length)return;
    slides[cur].classList.remove('active'); if(thumbs[cur])thumbs[cur].classList.remove('active');
    cur=((n%slides.length)+slides.length)%slides.length;
    slides[cur].classList.add('active'); if(thumbs[cur]){thumbs[cur].classList.add('active');thumbs[cur].scrollIntoView({block:'nearest',inline:'nearest'});}
  };
  var stage=document.getElementById('lhrStage');
  if(stage){var sx=0;
    stage.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
    stage.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)lhrGo(cur+(dx<0?1:-1));},{passive:true});
  }

  /* ship-by date (+4 days) — deferred so it also fills the stock-up section
     further down the page */
  function lhrFillDates(){
    var d=new Date();d.setDate(d.getDate()+4);
    var months=['January','February','March','April','May','June','July','August','September','October','November','December'];
    var day=d.getDate();
    var suf=(day%10===1&&day!==11)?'st':(day%10===2&&day!==12)?'nd':(day%10===3&&day!==13)?'rd':'th';
    [].slice.call(document.querySelectorAll('#lhrShipDate,[data-lhr-date]')).forEach(function(el){el.textContent=months[d.getMonth()]+' '+day+suf;});
  }
  lhrFillDates();
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',lhrFillDates);}

  /* offers */
  var opts=[].slice.call(document.querySelectorAll('#lhrOffers .lhr-opt'));
  function fmt(n){return '$'+Number(n).toFixed(2);}
  function render(){
    var sel=document.querySelector('#lhrOffers .lhr-opt.is-active'); if(!sel)return;
    var p=document.getElementById('lhrAtcPrice'); if(p)p.textContent=fmt(sel.getAttribute('data-total'));
    var s=document.getElementById('lhrAtcStrike'); if(s)s.textContent=fmt(sel.getAttribute('data-strike'));
    var v=document.getElementById('lhr-variant-input'); if(v)v.value=sel.getAttribute('data-variant');
    if(window.lpSyncSticky)window.lpSyncSticky(sel.getAttribute('data-total'),sel.getAttribute('data-strike'),sel.getAttribute('data-variant'));
  }
  opts.forEach(function(o){o.addEventListener('click',function(e){e.preventDefault();
    opts.forEach(function(x){x.classList.remove('is-active');});o.classList.add('is-active');render();});});
  render();

  window.lhrSelected=function(){return document.querySelector('#lhrOffers .lhr-opt.is-active');};
  window.lhrAtc=function(){
    var sel=window.lhrSelected(); if(!sel)return;
    var vid=sel.getAttribute('data-variant');
    if(!vid||vid.indexOf('REPLACE')!==-1){alert('Set your Shopify variant IDs in the section settings before going live.');return;}
    addToCart(parseInt(vid),1,null,'');
  };

  /* nutrition modal */
  window.lhrNut=function(open){
    var m=document.getElementById('lhrNutModal'); if(!m)return;
    m.style.display=open?'flex':'none';
    document.documentElement.style.overflow=open?'hidden':'';
  };
})();
</script>

