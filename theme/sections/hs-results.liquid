<section class="rsf hs-sec" id="results">
  <div class="wrap">
    <div class="rsf__card">
      {%- if section.settings.bg_image != blank -%}
        <div class="rsf__bg" style="background-image:url('{%- render 'pm-img-src', src: section.settings.bg_image -%}')" aria-hidden="true"></div>
      {%- endif -%}

      <div class="rsf__in">
        <div class="rsf__head">
          <h2 class="rsf__h">{{ section.settings.heading }}</h2>
          <p class="rsf__d">{{ section.settings.sub }}</p>
        </div>

        <div class="rsf__stats" id="rsfGrid">
          {% for n in (1..3) %}
            {% assign pk = 'pct_' | append: n %}
            {% assign tk = 'title_' | append: n %}
            {% assign bk = 'body_' | append: n %}
            {% if section.settings[tk] != blank %}
              <div class="rsf__item">
                <span class="rsf__pct" data-to="{{ section.settings[pk] }}">{{ section.settings[pk] }}%</span>
                <span class="rsf__t">{{ section.settings[tk] }}</span>
                <p class="rsf__b">{{ section.settings[bk] }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var grid=document.getElementById('rsfGrid'); if(!grid)return;
  var els=[].slice.call(grid.querySelectorAll('.rsf__pct'));
  // The real number is already in the markup, so no-JS and reduced-motion
  // visitors read the correct figure. We only zero it out immediately before
  // the count-up actually starts.
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce||!('IntersectionObserver' in window))return;
  var done=false;
  function run(){
    if(done)return; done=true;
    els.forEach(function(el){
      var to=parseInt(el.getAttribute('data-to'),10)||0, cur=0;
      var step=Math.max(1,Math.round(to/38));
      el.textContent='0%';
      var t=setInterval(function(){
        cur+=step; if(cur>=to){cur=to;clearInterval(t);}
        el.textContent=cur+'%';
      },26);
    });
  }
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)run();});},{threshold:.35});
  io.observe(grid);
})();
</script>

{% schema %}
{
  "name": "Results Felt By",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Results Reported By People Who Gave It A Whole Season"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Sub",
      "default": "We surveyed daily users at the end of last tick season and asked them what actually changed."
    },
    {
      "type": "text",
      "id": "bg_image",
      "label": "Card background",
      "default": "pm-riverside1-b88d5.webp"
    },
    {
      "type": "text",
      "id": "image",
      "label": "Feature image",
      "default": "pm-shot-dropper.webp"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Feature image alt",
      "default": "A woman taking Pinemoor Tick Protection Drops from the dropper"
    },
    {
      "type": "text",
      "id": "pct_1",
      "label": "1 · Percent",
      "default": "91"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "1 · Title",
      "default": "Came through the season without a bite"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "1 · Body",
      "default": "Not fewer than last year. None at all — on the same ground they have always walked."
    },
    {
      "type": "text",
      "id": "pct_2",
      "label": "2 · Percent",
      "default": "84"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "2 · Title",
      "default": "Stopped carrying a spray altogether"
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "2 · Body",
      "default": "One dropper with coffee replaced the can in the truck door, and the reapplying that never actually happened."
    },
    {
      "type": "text",
      "id": "pct_3",
      "label": "3 · Percent",
      "default": "78"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "3 · Title",
      "default": "Put the rest of the household on it too"
    },
    {
      "type": "textarea",
      "id": "body_3",
      "label": "3 · Body",
      "default": "It nearly always starts with one person and ends with the bottle living beside the coffee pot."
    }
  ],
  "presets": [
    {
      "name": "Results Felt By"
    }
  ]
}
{% endschema %}
