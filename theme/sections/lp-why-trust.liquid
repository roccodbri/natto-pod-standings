{%- comment -%}
  Dark green trust block: centered headline, three dashed icon tiles,
  then a two-column list of badge checkmarks.
{%- endcomment -%}
<section class="lpw">
  <div class="lp-wrap">
    <h2 class="lp-h2 lp-h2--c lp-h2--w">Why Trust Pinemoor?</h2>

    <div class="lpw-tiles">
      <div class="lpw-tile">
        <svg viewBox="0 0 24 24" fill="none" stroke="#5FFFB9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16c0 4-2.5 7.5-8 7.5S4 15 4 11z"/><path d="M12 18.5V21M8.5 21h7M14 4c-2.5.5-4 2-4.5 4.5M17 2.5c-1 2.5-2.5 4-5 4.5"/></svg>
        <span>Herbalist<br>Crafted</span>
      </div>
      <div class="lpw-tile">
        <svg viewBox="0 0 24 24" fill="none" stroke="#5FFFB9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v6.5L5 17a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 17l-5-8.5V2"/><path d="M8.5 2h7M7 14h10"/><path d="M12 6.5c1.5-1.5 3-2 4.5-1.5"/></svg>
        <span>Clean<br>Ingredients</span>
      </div>
      <div class="lpw-tile">
        <svg viewBox="0 0 24 24" fill="none" stroke="#5FFFB9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 13.5l4-2 4 2.5 4.5-2.5 4.5 2"/><path d="M4 14v4.5h16.5V14M8 11l3-3 3.5 2 3-2.5"/><circle cx="16.5" cy="6.5" r="3"/><path d="M15.4 6.5l.8.8 1.5-1.5"/></svg>
        <span>Trusted<br>Facilities</span>
      </div>
    </div>

    <div class="lpw-list">
      <div class="lpw-item"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> No DEET</div>
      <div class="lpw-item"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> No Artificial Additives</div>
      <div class="lpw-item"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> No Permethrin</div>
      <div class="lpw-item"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Gluten-Free</div>
      <div class="lpw-item"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Non-GMO</div>
      <div class="lpw-item"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Kid-Approved Taste</div>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 760px;}
.lpw{background:var(--lpg-dark);padding:48px 0 52px;}
.lpw-tiles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:30px;}
.lpw-tile{display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;
  background:rgba(255,255,255,.06);border:1.6px dashed rgba(255,255,255,.35);border-radius:10px;padding:24px 8px;}
.lpw-tile svg{width:44px;height:44px;}
.lpw-tile span{font-family:var(--lp-body);font-size:16px;font-weight:500;color:#fff;line-height:1.3;}
.lpw-list{display:grid;grid-template-columns:auto auto;justify-content:space-between;gap:22px 18px;margin-top:32px;}
.lpw-item{display:flex;align-items:center;gap:10px;font-family:var(--lp-body);font-size:17.5px;font-weight:500;color:#fff;}
.lpw-item svg{flex:none;width:22px;height:22px;}
@media(max-width:370px){ .lpw-item{font-size:15.5px;} }
</style>

{% schema %}{"name":"LP Why Trust","settings":[]}{% endschema %}
