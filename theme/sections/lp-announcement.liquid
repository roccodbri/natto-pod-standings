<div class="lpa" id="lp-announcement">
  <span class="lpa-txt">{{ section.settings.text }}</span>
  <div class="lpa-timer" id="lpaTimer">
    <span class="lpa-unit"><b id="lpaH">00</b> HRS</span>
    <span class="lpa-unit"><b id="lpaM">00</b> MIN</span>
    <span class="lpa-unit"><b id="lpaS">00</b> SEC</span>
  </div>
</div>

<style>
  .lpa{background:var(--v3-darker);color:#fff;display:flex;align-items:center;justify-content:center;
    gap:12px;padding:6px 10px;min-height:30px;}
  .lpa-txt{font-size:12px;font-weight:600;letter-spacing:.01em;}
  .lpa-timer{display:flex;gap:5px;}
  .lpa-unit{display:inline-flex;align-items:center;gap:3px;background:rgba(255,255,255,.14);
    border-radius:4px;padding:2px 7px;font-size:10px;font-weight:600;color:rgba(255,255,255,.75);}
  .lpa-unit b{font-size:11.5px;font-weight:700;color:#fff;font-variant-numeric:tabular-nums;}
</style>

<script>
(function(){
  /* rolling countdown: resets each midnight so the bar never reads 00:00:00 */
  var h=document.getElementById('lpaH'),m=document.getElementById('lpaM'),s=document.getElementById('lpaS');
  if(!h)return;
  function pad(n){return (n<10?'0':'')+n;}
  function tick(){
    var now=new Date(), end=new Date(now); end.setHours(23,59,59,999);
    var d=Math.max(0,end-now);
    h.textContent=pad(Math.floor(d/3600000));
    m.textContent=pad(Math.floor(d/60000)%60);
    s.textContent=pad(Math.floor(d/1000)%60);
  }
  tick(); setInterval(tick,1000);
})();
</script>

{% schema %}
{
  "name": "LP Announcement Timer",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"Summer Sale, 35% Off"}
  ]
}
{% endschema %}
