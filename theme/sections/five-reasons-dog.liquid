<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 820px;}

  .fr{background:var(--bg);padding:34px 0 38px;}
  .fr-wrap{max-width:1180px;margin:0 auto;}
  .fr-head{text-align:center;margin-bottom:22px;padding:0 18px;}
  .fr-badge{display:inline-block;background:transparent;color:var(--green-bright);font-family:var(--font-body);font-weight:700;
    font-size:16px;padding:0;border-radius:0;margin-bottom:10px;letter-spacing:.02em;}
  .fr-h{font-family:var(--font-head);font-weight:500;font-size:clamp(28px,6.6vw,40px);line-height:1.14;color:#000;max-width:680px;margin:0 auto;letter-spacing:normal}
  .fr-rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 16px 4px;}
  .fr-rail::-webkit-scrollbar{display:none;}
  .fr-card{flex:0 0 85%;max-width:360px;scroll-snap-align:center;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;}
  .fr-img{width:100%;height:210px;overflow:hidden;background:var(--tint);}
  .fr-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .fr-body{padding:16px 18px 20px;}
  .fr-num{display:inline-block;background:var(--green-deep);color:#fff;font-family:var(--font-body);font-weight:700;font-size:11px;padding:4px 10px;border-radius:5px;margin-bottom:11px;}
  .fr-title{font-family:var(--font-head);font-weight:500;letter-spacing:normal;font-size:19px;color:#000;margin-bottom:9px;line-height:1.2;}
  .fr-text{font-family:var(--font-body);font-size:14.5px;line-height:1.55;color:var(--muted);}
  .fr-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px;}
  .fr-arrow{width:38px;height:38px;border-radius:50%;background:#fff;border:1px solid var(--line);color:var(--green-deep);font-size:22px;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.07);}
  .fr-dots{display:flex;gap:7px;}
  .fr-dots button{width:8px;height:8px;border-radius:50%;background:#E4EDE6;transition:.2s;}
  .fr-dots button.active{background:var(--green-bright);transform:scale(1.3);}
  .fr-cta{margin-top:26px;max-width:430px;margin-left:auto;margin-right:auto;text-align:center;padding:0 18px;}

  @media (min-width:760px){
    .fr-h{font-size:clamp(28px,6.6vw,40px);}
    .fr-rail{justify-content:center;overflow-x:visible;flex-wrap:wrap;}
    .fr-card{flex:0 0 270px;}
    .fr-nav{display:none;}
  }
</style>

<script>
(function(){
  var rail=document.getElementById('frRail'); if(!rail)return;
  var cards=[].slice.call(rail.querySelectorAll('.fr-card'));
  var dotsWrap=document.getElementById('frDots');
  var cur=0;
  cards.forEach(function(_,i){
    var b=document.createElement('button');b.setAttribute('aria-label','Reason '+(i+1));
    if(i===0)b.classList.add('active');
    b.addEventListener('click',function(){go(i);});
    dotsWrap.appendChild(b);
  });
  var dots=[].slice.call(dotsWrap.children);
  function go(i){cur=Math.max(0,Math.min(cards.length-1,i));cards[cur].scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});}
  document.getElementById('frPrev').addEventListener('click',function(){go(cur-1);});
  document.getElementById('frNext').addEventListener('click',function(){go(cur+1);});
  var raf;
  rail.addEventListener('scroll',function(){
    if(raf)cancelAnimationFrame(raf);
    raf=requestAnimationFrame(function(){
      var i=Math.round(rail.scrollLeft/(rail.scrollWidth/cards.length));
      cur=Math.max(0,Math.min(cards.length-1,i));
      dots.forEach(function(d,idx){d.classList.toggle('active',idx===cur);});
    });
  },{passive:true});
})();
</script>

