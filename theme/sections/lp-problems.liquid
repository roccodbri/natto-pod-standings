{%- comment -%}
  Light section: headline + sub, media card, then check-badge benefit rows.
{%- endcomment -%}
<section class="lpp">
  <div class="lp-wrap">
    <h2 class="lp-h2">When a Tick Locks On, Problems Start</h2>
    <p class="lp-sub">Ticks don&rsquo;t see you &mdash; they smell you. Every hour outside, your skin broadcasts the exact cues they hunt by. Pinemoor quiets those signals from the inside.</p>

    <div class="lpp-media">
      <img src="{{ 'pm-yell-10115-b1f2d.webp' | asset_url }}" alt="Tick questing on tall grass" loading="lazy" decoding="async" width="800" height="533">
    </div>

    <div class="lpp-checks">
      <div class="lp-check"><svg class="lp-badgeic" viewBox="0 0 24 24" fill="#199B62" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Blocks the Scent They Hunt By</div>
      <div class="lp-check"><svg class="lp-badgeic" viewBox="0 0 24 24" fill="#199B62" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Covers Every Inch of You, 24 Hours</div>
      <div class="lp-check"><svg class="lp-badgeic" viewBox="0 0 24 24" fill="#199B62" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> No DEET, Nothing on Your Skin</div>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 780px;}
.lpp{background:var(--lp-mint);padding:44px 0 46px;}
.lpp-media{border-radius:14px;overflow:hidden;margin-top:24px;}
.lpp-media img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;}
.lpp-checks{display:flex;flex-direction:column;gap:18px;margin-top:26px;}
</style>

