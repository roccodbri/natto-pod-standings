<section class="cs" id="pm-clinical">
  <div class="cs-bg" aria-hidden="true"></div>
  <div class="cs-wrap">

    <div class="cs-head">
      <h2 class="cs-title">Clinically Studied.<br><span class="cs-title-accent">24-Hour Tick Repellence. All Natural.</span></h2>
      <p class="cs-sub">When traditional botanicals meet modern research, the results speak for themselves.</p>
    </div>

    <div class="cs-stats" id="csStats">
      <div class="cs-stat"><span class="cs-num" data-target="82" data-suffix="">0</span><span class="cs-label">Clinical trials on our 6 herbal extracts</span></div>
      <div class="cs-stat"><span class="cs-num" data-target="7000" data-suffix="mg" data-comma="1">0</span><span class="cs-label">Of botanicals per serving</span></div>
      <div class="cs-stat"><span class="cs-num" data-target="2000" data-suffix="+">0</span><span class="cs-label">Years of traditional anti-tick use</span></div>
      <div class="cs-stat"><span class="cs-num" data-target="100" data-suffix="k+">0</span><span class="cs-label">Orders shipped</span></div>
    </div>

    <div class="cs-cta">
      <button type="button" class="btn-cream" onclick="pmScrollTop(event)">Try Pinemoor Today</button>
      <p class="guarantee-line" style="color:rgba(255,255,255,.85);">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Lifetime money-back guarantee
      </p>
    </div>

  </div>
</section>

<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 680px;}

  .cs{position:relative;background:var(--green-deep);color:#fff;overflow:hidden;padding:72px 16px 80px;}
  .cs-bg{position:absolute;inset:0;
    background:url('{{ 'pm-your-guide-to-kitchen-herbs-and-sp-5ee97.webp' | asset_url }}') center/cover;
    opacity:.13;mix-blend-mode:luminosity;}
  .cs-wrap{position:relative;max-width:560px;margin:0 auto;}
  .cs-head{text-align:center;margin-bottom:50px;}
  .cs-title{font-family:var(--font-head);font-weight:500;font-size:26px;line-height:1.18;color:#fff;letter-spacing:normal;}
  .cs-title-accent{color:#fff;}
  .cs-sub{font-size:15px;line-height:1.55;color:rgba(255,255,255,.82);margin-top:14px;max-width:420px;margin-left:auto;margin-right:auto;}
  .cs-stats{display:grid;grid-template-columns:1fr 1fr;gap:44px 18px;margin-bottom:52px;}
  .cs-stat{text-align:left;border-top:1px solid rgba(255,255,255,.18);padding-top:12px;}
  .cs-num{display:block;font-family:var(--font-head);font-weight:500;font-size:36px;line-height:1;color:#fff;}
  .cs-label{display:block;font-size:13px;color:rgba(255,255,255,.78);margin-top:7px;line-height:1.35;}
  .cs-cta{max-width:430px;margin:0 auto;text-align:center;}

  @media (min-width:760px){
    .cs{padding:88px 24px;}
    .cs-wrap{max-width:1040px;display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:center;}
    .cs-head{order:2;text-align:left;margin-bottom:0;}
    .cs-stats{order:1;margin-bottom:0;gap:30px 26px;}
    .cs-title{font-size:32px;}
    .cs-head .cs-sub{margin-left:0;}
    .cs-cta{grid-column:1 / -1;max-width:none;display:flex;flex-direction:column;align-items:center;}
    .cs-cta .btn-cream{max-width:430px;}
  }
</style>

<script>
(function(){
  var section=document.getElementById('pm-clinical');
  if(!section)return;
  var done=false;
  function fmt(n,comma){var v=Math.round(n);return comma?v.toLocaleString('en-US'):String(v);}
  function run(){
    if(done)return;done=true;
    section.querySelectorAll('.cs-num').forEach(function(el){
      var target=parseInt(el.getAttribute('data-target'),10);
      var suffix=el.getAttribute('data-suffix')||'';
      var comma=el.getAttribute('data-comma')==='1';
      var dur=1400,start=null;
      function step(ts){
        if(!start)start=ts;
        var p=Math.min((ts-start)/dur,1);
        var eased=1-Math.pow(1-p,3);
        el.textContent=fmt(target*eased,comma)+suffix;
        if(p<1)requestAnimationFrame(step);else el.textContent=fmt(target,comma)+suffix;
      }
      requestAnimationFrame(step);
    });
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){run();io.disconnect();}},{threshold:.4});
    io.observe(section);
  }else{run();}
})();
</script>

{% schema %}{"name":"Clinically Studied V2","settings":[]}{% endschema %}
