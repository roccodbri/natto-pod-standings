{%- comment -%}
  Dark green journey timeline: hero image card, headline + sub, then a left
  timeline rail with week rows, badge checkpoints and stat callout boxes.
{%- endcomment -%}
<section class="lpj">
  <div class="lp-wrap">
    <div class="lpj-img"><img src="{{ 'pm-riverside1-b88d5.webp' | asset_url }}" alt="Back outside without worrying about ticks" loading="lazy" decoding="async" width="800" height="533"></div>
    <h2 class="lp-h2 lp-h2--w lpj-h">Your Tick-Proof Journey</h2>
    <p class="lpj-sub">Real, daily protection &mdash; not a one-off spray.</p>

    <div class="lpj-trail">
      <span class="lpj-line" aria-hidden="true"></span>

      <div class="lpj-week">
        <span class="lpj-node" aria-hidden="true"></span>
        <div class="lpj-weekcard"><span class="lpj-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></span><span class="lpj-wktxt"><b>Week 1:</b> &nbsp;Feel the Shift Begin</span></div>
      </div>
      <div class="lpj-points">
        <div class="lpj-point"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,.55)" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> The botanicals reach your skin&rsquo;s scent</div>
        <div class="lpj-point"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,.55)" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Ticks start climbing off before biting</div>
        <div class="lpj-callout"><b>Most customers</b> report their last tick within the first week</div>
      </div>

      <div class="lpj-week">
        <span class="lpj-node" aria-hidden="true"></span>
        <div class="lpj-weekcard"><span class="lpj-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></span><span class="lpj-wktxt"><b>Week 2:</b> &nbsp;Notice the Quiet</span></div>
      </div>
      <div class="lpj-points">
        <div class="lpj-point"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,.55)" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Tick checks come up clean</div>
        <div class="lpj-point"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,.55)" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> The spray can stays in the truck door</div>
        <div class="lpj-callout"><b>91% of surveyed users</b> reported zero bites across the full season</div>
      </div>

      <div class="lpj-week">
        <span class="lpj-node" aria-hidden="true"></span>
        <div class="lpj-weekcard"><span class="lpj-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></span><span class="lpj-wktxt"><b>Week 4:</b> &nbsp;Season-Long Armor</span></div>
      </div>
      <div class="lpj-points lpj-points--last">
        <div class="lpj-point"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,.55)" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> Coffee, drops, out the door &mdash; a habit now</div>
        <div class="lpj-point"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,.55)" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg> The whole family covered from one bottle</div>
        <div class="lpj-callout"><b>78% of surveyed users</b> put the rest of the household on it</div>
      </div>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 1500px;}
.lpj{background:var(--lpg-dark);padding:40px 0 52px;}
.lpj-img{border-radius:14px;overflow:hidden;}
.lpj-img img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block;}
.lpj-h{text-align:left;margin-top:30px;}
.lpj-sub{font-family:var(--lp-body);font-size:17px;color:rgba(255,255,255,.8);margin-top:12px;}
.lpj-trail{position:relative;margin-top:30px;padding-left:34px;}
.lpj-line{position:absolute;left:9px;top:20px;bottom:30px;width:2px;background:rgba(255,255,255,.28);}
.lpj-week{position:relative;margin-top:30px;}
.lpj-week:first-of-type{margin-top:0;}
.lpj-node{position:absolute;left:-34px;top:50%;transform:translateY(-50%);width:20px;height:20px;border-radius:50%;
  background:#3D7F5F;box-shadow:0 0 0 4px var(--lpg-dark);}
.lpj-node::after{content:"";position:absolute;left:20px;top:50%;width:14px;height:2px;background:rgba(255,255,255,.28);transform:translateY(-50%);}
.lpj-weekcard{display:flex;align-items:center;background:rgba(255,255,255,.08);border-radius:12px;padding:20px 18px;
  font-family:var(--lp-body);font-size:21px;color:#fff;}
.lpj-weekcard b{font-weight:700;}
.lpj-wktxt{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.lpj-arrow{flex:none;width:38px;height:38px;border-radius:50%;border:1.6px solid rgba(255,255,255,.7);color:#fff;
  display:flex;align-items:center;justify-content:center;margin-right:14px;}
.lpj-arrow svg{width:15px;height:15px;}
.lpj-points{margin-top:20px;display:flex;flex-direction:column;gap:16px;}
.lpj-point{display:flex;align-items:flex-start;gap:11px;font-family:var(--lp-body);font-size:18px;font-weight:500;color:#fff;line-height:1.35;}
.lpj-point svg{flex:none;width:22px;height:22px;margin-top:1px;}
.lpj-callout{background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.25);border-radius:12px;padding:18px 18px;
  font-family:var(--lp-body);font-size:18px;line-height:1.4;color:#fff;margin-top:6px;}
.lpj-callout b{color:#5FFFB9;font-weight:700;}
</style>

{% schema %}{"name":"LP Journey Timeline","settings":[]}{% endschema %}
