<header class="site-header">
  <div class="site-header__inner">

    <!-- Menu -->
    <button class="site-header__hamburger" type="button" aria-label="Menu" aria-haspopup="true" aria-expanded="false" onclick="openMobileNav()">
      <span></span><span></span><span></span>
    </button>

    <!-- Logo: centered -->
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="home">
      <span class="site-header__logo-text">{{ section.settings.brand | default: 'pinemoor' }}</span>
    </a>

    <!-- Cart: right (search removed) -->
    <div class="site-header__icons">
      <button class="site-header__cart-btn" onclick="openCartDrawer()" aria-label="Open cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="cart-count" style="display:none">0</span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile hamburger dropdown -->
<div class="mobile-nav-overlay" id="mobile-nav-overlay" onclick="closeMobileNav()"></div>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile menu">
  <button class="mobile-nav__close" type="button" aria-label="Close menu" onclick="closeMobileNav()">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <ul class="mobile-nav__links">
    <li><a href="#" onclick="event.preventDefault();closeMobileNav();window.scrollTo({top:0,behavior:'smooth'});">Tick Protection Drops</a></li>
    <li><a href="https://pinemoor.co/a/loop_subscriptions/get-subscription-link">Manage Subscription</a></li>
  </ul>
</nav>

<script>
  function openMobileNav(){
    document.getElementById('mobile-nav').classList.add('open');
    document.getElementById('mobile-nav-overlay').classList.add('open');
    document.body.style.overflow='hidden';
    var h=document.querySelector('.site-header__hamburger'); if(h)h.setAttribute('aria-expanded','true');
  }
  function closeMobileNav(){
    document.getElementById('mobile-nav').classList.remove('open');
    document.getElementById('mobile-nav-overlay').classList.remove('open');
    document.body.style.overflow='';
    var h=document.querySelector('.site-header__hamburger'); if(h)h.setAttribute('aria-expanded','false');
  }
</script>

{% schema %}
{
  "name": "Header V2",
  "settings": [
    {"type":"text","id":"brand","label":"Brand name","default":"pinemoor"}
  ]
}
{% endschema %}
