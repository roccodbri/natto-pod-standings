{%- comment -%}
  Comparison table: headline left, floating product-column card (dark green,
  bottle image, brand name) vs "Other brands", dashed row grid with green
  badge checks and red circle X marks.
{%- endcomment -%}
<section class="lpc">
  <div class="lp-wrap">
    <h2 class="lp-h2">See the Difference for Yourself</h2>

    <div class="lpc-cols">
      <span class="lpc-spacer"></span>
      <div class="lpc-brandcol">
        <img src="https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260713_233510_2fd30a75-bcc7-4fe8-a2b9-d92c9085bdba.png?v=1783998610&width=300" alt="Pinemoor bottle" loading="lazy" decoding="async" width="120" height="120">
        <span>Pinemoor</span>
      </div>
      <div class="lpc-othercol">Other brands</div>
    </div>

    <div class="lpc-table">
      <div class="lpc-row"><span class="lpc-label">Works From the Inside Out</span><span class="lpc-yes"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg></span><span class="lpc-no"><svg viewBox="0 0 24 24" fill="none" stroke="#B91414" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span></div>
      <div class="lpc-row"><span class="lpc-label">24-Hour Whole-Body Coverage</span><span class="lpc-yes"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg></span><span class="lpc-no"><svg viewBox="0 0 24 24" fill="none" stroke="#B91414" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span></div>
      <div class="lpc-row"><span class="lpc-label">No DEET or Harsh Chemicals</span><span class="lpc-yes"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg></span><span class="lpc-no"><svg viewBox="0 0 24 24" fill="none" stroke="#B91414" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span></div>
      <div class="lpc-row"><span class="lpc-label">Safe for Kids &amp; the Whole Family</span><span class="lpc-yes"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg></span><span class="lpc-no"><svg viewBox="0 0 24 24" fill="none" stroke="#B91414" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span></div>
      <div class="lpc-row"><span class="lpc-label">Real, Noticeable Protection</span><span class="lpc-yes"><svg viewBox="0 0 24 24" fill="#5FFFB9" aria-hidden="true"><path d="M12 1.7l2.2 1.6 2.7-.4 1 2.5 2.5 1-.4 2.7 1.6 2.2-1.6 2.2.4 2.7-2.5 1-1 2.5-2.7-.4-2.2 1.6-2.2-1.6-2.7.4-1-2.5-2.5-1 .4-2.7L2.4 12 4 9.8l-.4-2.7 2.5-1 1-2.5 2.7.4zM10.9 14.2l5-5-1.1-1.1-3.9 3.9-1.7-1.7-1.1 1.1z"/></svg></span><span class="lpc-no"><svg viewBox="0 0 24 24" fill="none" stroke="#B91414" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span></div>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 780px;}
.lpc{background:#fff;padding:44px 0 52px;}
.lpc-cols{display:grid;grid-template-columns:1fr 96px 96px;gap:0 8px;align-items:end;margin-top:10px;}
.lpc-brandcol{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:4px;
  background:var(--lpg-dark);border-radius:12px 12px 0 0;padding:14px 8px 10px;margin-bottom:-2px;}
.lpc-brandcol img{width:74px;height:auto;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35));}
.lpc-brandcol span{font-family:var(--lp-body);font-weight:600;font-size:14.5px;color:#fff;}
.lpc-othercol{text-align:center;font-family:var(--lp-body);font-weight:700;font-size:15px;color:var(--lp-ink);padding-bottom:12px;line-height:1.25;}
.lpc-table{border:1.6px dashed #A9D8C2;border-radius:12px;overflow:hidden;}
.lpc-row{display:grid;grid-template-columns:1fr 96px 96px;gap:0 8px;align-items:stretch;background:var(--lp-mint);
  border-top:1.6px dashed #A9D8C2;}
.lpc-row:first-child{border-top:none;}
.lpc-label{font-family:var(--lp-body);font-weight:600;font-size:16.5px;line-height:1.3;color:var(--lp-ink);
  display:flex;align-items:center;padding:22px 14px;}
.lpc-yes{background:var(--lpg-dark);display:flex;align-items:center;justify-content:center;}
.lpc-yes svg{width:30px;height:30px;}
.lpc-no{display:flex;align-items:center;justify-content:center;}
.lpc-no svg{width:28px;height:28px;}
</style>

{% schema %}{"name":"LP Comparison Table","settings":[]}{% endschema %}
