{%- comment -%}
  UGC media carousel under the hero: big rounded media card, arrow nav below.
{%- endcomment -%}
<section class="lpu">
  <div class="lp-wrap">
    <h2 class="lp-h2 lp-h2--c">Their Season Says It All</h2>
    <div class="lpu-rail lp-rail" id="lpuRail">
      <div class="lpu-card">
        <video data-pm-video data-src="{{ 'pinemoor-video.mp4' | asset_url }}" poster="{{ 'pinemoor-video-poster.webp' | asset_url }}" muted loop playsinline preload="none" disablepictureinpicture></video>
      </div>
      <div class="lpu-card"><img src="{{ 'pm-camping2-1-62a88.webp' | asset_url }}" alt="Family camping tick-free with Pinemoor" loading="lazy" decoding="async" width="1000" height="562"></div>
      <div class="lpu-card"><img src="{{ 'pm-amy-quinn-and-dogs-on-white-rocks--21315.webp' | asset_url }}" alt="Hiking with dogs, protected by Pinemoor" loading="lazy" decoding="async" width="800" height="531"></div>
      <div class="lpu-card"><img src="{{ 'pm-hnd24-hunt-1-40128.webp' | asset_url }}" alt="Hunter in tick country" loading="lazy" decoding="async" width="800" height="600"></div>
    </div>
    <div class="lp-arrows">
      <button class="lp-arrow" id="lpuPrev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
      <button class="lp-arrow" id="lpuNext" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 760px;}
.lpu{background:#fff;padding:30px 0 40px;}
.lpu-rail{margin-top:24px;padding-bottom:4px;}
.lpu-card{width:100%;max-width:100%;border-radius:14px;overflow:hidden;background:var(--lp-mint-2);}
.lpu-card video,.lpu-card img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;}
</style>

<script>
lpRail('lpuRail','lpuPrev','lpuNext');
(function(){
  var v=document.querySelector('.lpu-card video'); if(!v)return; v.muted=true;
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){});}else{v.pause();}
    });},{threshold:.35});
    io.observe(v);
  }
})();
</script>

{% render 'pm-lazy-video' %}

{% schema %}{"name":"LP UGC Carousel","settings":[]}{% endschema %}
