<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 900px;}

  .rv{background:var(--bg);padding:34px 16px 40px;}
  .rv-wrap{max-width:620px;margin:0 auto;}
  .rv-head{text-align:center;margin-bottom:24px;}
  .rv-rate{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:10px;}
  .rv-stars{color:var(--green-bright);letter-spacing:1px;}
  .rv-rate-txt{font-size:13.5px;color:var(--ink);font-weight:500;}
  .rv-list{display:flex;flex-direction:column;gap:14px;}
  .rv-card{border:1px solid var(--line);border-radius:8px;padding:18px 18px 16px;background:#fff;}
  .rv-cardtop{display:flex;align-items:center;gap:9px;margin-bottom:10px;}
  .rv-score{font-family:var(--font-body);font-weight:700;font-size:14px;color:#000;}
  .rv-cstars{color:var(--green-bright);letter-spacing:1.5px;font-size:14px;}
  .rv-title{font-family:var(--font-head);font-weight:500;letter-spacing:normal;font-size:16px;color:#000;margin-bottom:8px;line-height:1.3;}
  .rv-text{font-family:var(--font-body);font-size:14.5px;line-height:1.6;color:var(--muted);margin-bottom:13px;}
  .rv-foot{display:flex;align-items:center;gap:10px;margin-bottom:11px;}
  .rv-name{font-family:var(--font-body);font-weight:700;font-size:13.5px;color:#000;}
  .rv-verified{font-family:var(--font-body);font-size:12px;font-weight:500;color:var(--green-bright);}
  .rv-pills{display:flex;flex-wrap:wrap;gap:7px;}
  .rv-pills span{font-family:var(--font-body);font-size:12px;font-weight:500;color:var(--green-deep);border:1px solid rgba(0,147,112,.4);
    background:var(--green-bright-soft);padding:5px 11px;border-radius:50px;}

  @media (min-width:760px){
    .rv-wrap{max-width:760px;}
    .rv-list{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;}
  }
</style>

