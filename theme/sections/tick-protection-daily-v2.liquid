<section class="tp" id="pm-daily">
  <div class="tp-texture" aria-hidden="true"></div>
  <div class="tp-wrap">
    <div class="tp-head">
      <h2 class="tp-title">All Day Tick Protection. <span class="tp-title-2">Every Day.</span></h2>
      <p class="tp-sub">Here&rsquo;s what Pinemoor does every morning.</p>
    </div>

    <div class="tp-grid">
      <div class="tp-benefits">
        <div class="tp-benefit">
          <span class="tp-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <span class="tp-label">24-Hour Tick Defense</span>
        </div>
        <div class="tp-benefit">
          <span class="tp-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="3"/><path d="M12 9v7m0 0l-3 5m3-5l3 5M7 12h10"/></svg></span>
          <span class="tp-label">Whole-Body Coverage</span>
        </div>
        <div class="tp-benefit">
          <span class="tp-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2.5"/><circle cx="16" cy="8" r="2.5"/><path d="M3.5 19c0-2.8 2-5 4.5-5s4.5 2.2 4.5 5M12.5 19c.3-2.4 2.1-4 4-4 2.2 0 4 2.2 4 5"/></svg></span>
          <span class="tp-label">Safe for the Whole Family</span>
        </div>
        <div class="tp-benefit">
          <span class="tp-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M9 5.5A3.5 3.5 0 0 1 15 8c0 1-.3 1.8-.8 2.5M6 12c-1 1.5-1.5 3.2-1.5 5h11"/></svg></span>
          <span class="tp-label">No Sprays or Chemicals</span>
        </div>
      </div>

      <div class="tp-media">
        <span class="tp-glow" aria-hidden="true"></span>
        <video id="tpVideo" data-pm-video data-src="{{ 'pinemoor-video.mp4' | asset_url }}" poster="{{ 'pinemoor-video-poster.webp' | asset_url }}" muted loop playsinline preload="none" disablepictureinpicture></video>
      </div>
    </div>
  </div>
</section>

<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 720px;}

  .tp{position:relative;background:radial-gradient(130% 80% at 50% 106%, rgba(0,205,145,.42), rgba(0,205,145,0) 50%), linear-gradient(180deg,#03110c 0%,#0d4a37 52%,#1c8463 100%);color:#fff;padding:46px 16px 52px;overflow:hidden;}
  .tp-texture{position:absolute;inset:0;pointer-events:none;opacity:.6;
    background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1.6px);background-size:22px 22px;
    -webkit-mask-image:radial-gradient(ellipse at center,#000 35%,transparent 80%);mask-image:radial-gradient(ellipse at center,#000 35%,transparent 80%);}
  .tp-wrap{position:relative;max-width:1080px;margin:0 auto;}
  .tp-head{text-align:center;margin-bottom:30px;}
  .tp-title{font-family:var(--font-head);font-weight:500;font-size:26px;line-height:1.18;color:#fff;letter-spacing:normal;}
  .tp-title-2{display:inline;color:#11d39d;}
  .tp-sub{font-family:var(--font-body);font-size:15px;font-weight:400;color:rgba(255,255,255,.82);margin-top:10px;}
  .tp-grid{display:flex;flex-direction:column;gap:34px;align-items:center;}
  .tp-benefits{display:grid;grid-template-columns:1fr 1fr;gap:26px 16px;width:100%;max-width:430px;}
  .tp-benefit{display:flex;flex-direction:column;align-items:center;text-align:center;gap:11px;}
  .tp-ic{display:flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:50%;
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.22);box-shadow:0 4px 18px rgba(0,0,0,.18);}
  .tp-label{font-family:var(--font-head);font-weight:500;font-size:15px;line-height:1.25;color:#fff;max-width:150px;}

  .tp-media{position:relative;width:100%;max-width:330px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;margin:6px auto;}
  .tp-glow{position:absolute;width:78%;height:78%;border-radius:50%;
    background:radial-gradient(circle,rgba(0,147,112,.55),rgba(0,147,112,0) 68%);filter:blur(22px);z-index:0;}
  .tp-media video{position:relative;z-index:2;width:74%;border-radius:18px;display:block;background:#000;
    box-shadow:0 14px 40px rgba(0,0,0,.42), 0 0 0 1px rgba(255,255,255,.08);}

  @media (min-width:760px){
    .tp-title{font-size:30px;}
    .tp-grid{flex-direction:row;justify-content:center;gap:54px;}
    .tp-benefits{order:1;}
    .tp-media{order:2;max-width:400px;}
  }
</style>

<script>
(function(){
  var v=document.getElementById('tpVideo'); if(!v)return; v.muted=true;
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){});}else{v.pause();}
    });},{threshold:.35});
    io.observe(v);
  }else{var p=v.play();if(p&&p.catch)p.catch(function(){});}
})();
</script>

{% render 'pm-lazy-video' %}

