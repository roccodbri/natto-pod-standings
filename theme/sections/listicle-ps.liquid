<script>
(function(){
  var d=new Date();
  var m=['January','February','March','April','May','June','July','August','September','October','November','December'];
  var el=document.getElementById('psDate'); if(el) el.textContent=m[d.getMonth()]+' '+d.getDate()+', '+d.getFullYear();
  var y=document.getElementById('psYear'); if(y) y.textContent=d.getFullYear();
  var t=document.getElementById('ctaTimer');
  if(t){
    var secs=15*60;
    setInterval(function(){
      if(secs>0)secs--;
      var mm=Math.floor(secs/60),ss=secs%60;
      t.textContent=(mm<10?'0':'')+mm+':'+(ss<10?'0':'')+ss;
    },1000);
  }
})();
</script>

