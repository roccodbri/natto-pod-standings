    <div class="mp-sticky-info"><span class="mp-sticky-name">MeshProtect&trade; Kit</span><span class="mp-sticky-price" id="mpStickyPrice">$79.98</span></div>
    <button type="button" class="mp-sticky-btn" onclick="mpAddToCart(this)">Add to cart</button>
  </div>
</div>

<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 1600px;}

  .mp{font-family:var(--font-body);color:var(--ink);overflow-x:clip;max-width:100%;}
  .mp-wrap{max-width:1080px;margin:0 auto;padding:34px 18px;}
  .mp .center{text-align:center;}
  .mp h2{font-size:clamp(28px,6.6vw,40px);line-height:1.16;margin-bottom:14px;}
  .mp-eyebrow{display:inline-block;font-family:var(--font-body);font-weight:700;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--green-bright);margin-bottom:8px;}
  .mp-eyebrow.center{display:block;text-align:center;}
  .mp-lead{font-size:15.5px;line-height:1.6;color:var(--muted);max-width:720px;margin:0 auto 18px;}
  .mp-small{font-size:12.5px;color:var(--muted-2);}

  /* HERO */
  .mp-hero{background:#fff;padding:18px 0 8px;}
  .mp-hero-grid{max-width:1080px;margin:0 auto;padding:0 18px;display:grid;grid-template-columns:minmax(0,1fr);gap:22px;}
  .mp-gallery,.mp-buy{min-width:0;}
  .mp-stage{background:var(--tint);border-radius:14px;overflow:hidden;aspect-ratio:1/1;}
  .mp-stage img{width:100%;height:100%;object-fit:cover;}
  .mp-thumbs{display:flex;gap:9px;margin-top:10px;overflow-x:auto;scrollbar-width:none;}
  .mp-thumbs::-webkit-scrollbar{display:none;}
  .mp-thumb{flex:0 0 70px;width:70px;height:70px;border-radius:9px;overflow:hidden;border:2px solid transparent;background:var(--tint);}
  .mp-thumb.active{border-color:var(--green);}
  .mp-thumb img{width:100%;height:100%;object-fit:cover;}

  .mp-title{font-size:25px;line-height:1.15;margin-bottom:8px;}
  .mp-rating{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px;}
  .mp-stars{color:#f5a623;letter-spacing:1px;font-size:15px;}
  .mp-rating-txt{font-size:13px;color:var(--muted);}
  .mp-rating-txt a{text-decoration:underline;}
  .mp-stock{display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600;color:var(--green-deep);margin-bottom:4px;}
  .mp-dot{width:8px;height:8px;border-radius:50%;background:var(--green-bright);display:inline-block;}
  .mp-lowstock{font-size:12.5px;color:#c0392b;margin-bottom:14px;}
  .mp-bullets{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:16px;}
  .mp-bullets li{position:relative;padding-left:24px;font-size:14.5px;line-height:1.45;color:var(--ink);}
  .mp-bullets li:before{content:"✓";position:absolute;left:0;top:0;color:var(--green-bright);font-weight:800;}
  .mp-freecallout{background:var(--green-bright-soft);border:1px dashed var(--green-bright);border-radius:10px;padding:11px 14px;font-size:13.5px;color:var(--green-deep);margin-bottom:16px;}

  .mp-kitbox{display:flex;gap:14px;align-items:center;background:var(--tint);border-radius:12px;padding:12px;margin-bottom:18px;}
  .mp-kitbox-img{width:118px;height:118px;object-fit:cover;border-radius:9px;flex:none;}
  .mp-kitlist{list-style:none;flex:1;display:flex;flex-direction:column;gap:7px;}
  .mp-kitlist li{display:flex;justify-content:space-between;font-size:13.5px;border-bottom:1px solid var(--line);padding-bottom:6px;}
  .mp-kp{font-weight:700;color:var(--green-deep);}
  .mp-kp s{color:var(--muted-2);font-weight:400;margin-right:4px;}

  .mp-bundles{display:flex;flex-direction:column;gap:10px;margin-bottom:18px;}
  .mp-bundle{position:relative;display:flex;flex-direction:column;gap:3px;text-align:left;border:2px solid var(--line);border-radius:12px;padding:12px 14px;background:#fff;transition:.15s;}
  .mp-bundle.active{border-color:var(--green);background:var(--green-bright-soft);}
  .mp-bundle-top{display:flex;align-items:center;gap:10px;}
  .mp-bundle-qty{font-family:var(--font-head);font-weight:600;font-size:17px;}
  .mp-bundle-tag{font-size:11.5px;font-weight:700;color:var(--green-bright);background:#fff;border:1px solid var(--green-bright);border-radius:20px;padding:1px 9px;}
  .mp-bundle-price{font-size:12.5px;color:var(--muted);}
  .mp-bundle-badge{position:absolute;top:-9px;right:12px;font-size:10.5px;font-weight:700;color:#fff;background:var(--green);border-radius:20px;padding:2px 9px;}

  .mp-opt{margin-bottom:16px;}
  .mp-opt-label{font-size:13.5px;font-weight:600;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;}
  .mp-sizeguide{font-weight:500;font-size:12.5px;color:var(--green-bright);text-decoration:underline;cursor:pointer;}
  .mp-swatches{display:flex;gap:8px;}
  .mp-swatch{width:34px;height:34px;border-radius:50%;border:2px solid var(--line);}
  .mp-swatch.active{border-color:var(--green);box-shadow:0 0 0 2px #fff inset;}
  .mp-sizes{display:flex;gap:8px;}
  .mp-size{flex:1;border:2px solid var(--line);border-radius:10px;padding:12px 0;font-weight:600;font-size:15px;background:#fff;transition:.15s;}
  .mp-size.active{border-color:var(--green);background:var(--green);color:#fff;}
  .mp-kitsize{margin-bottom:10px;}
  .mp-kitsize[hidden]{display:none;}
  .mp-kitsize-label{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:5px;}
  .mp-fit{font-size:12.5px;color:var(--muted);margin-top:8px;}
  .mp-overclothes{font-size:12.5px;color:var(--muted);margin-bottom:16px;line-height:1.5;}

  .mp-pricerow{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
  .mp-compare{color:var(--muted-2);font-size:16px;}
  .mp-price{font-family:var(--font-head);font-weight:600;font-size:22px;color:var(--ink);}
  .mp-savebadge{font-size:11.5px;font-weight:700;color:#fff;background:#c0392b;border-radius:6px;padding:3px 8px;}

  .mp-atc{width:100%;background:var(--green);color:#fff;border-radius:12px;padding:17px;font-family:var(--font-body);font-weight:500;font-size:14.5px;letter-spacing:.8px;text-transform:uppercase;box-shadow:0 6px 18px rgba(9,89,70,.25);}
  .mp-atc:active{transform:translateY(1px);}
  .mp-trust{display:flex;justify-content:center;flex-wrap:wrap;gap:13px;margin-top:13px;font-size:11.5px;font-weight:600;color:var(--green-deep);}
  .mp-trust span{display:inline-flex;align-items:center;gap:5px;}
  .mp-trust svg{width:15px;height:15px;}
  .mp-delivery{display:flex;align-items:center;justify-content:center;gap:6px;font-size:12.5px;color:var(--muted);margin-top:11px;}

  /* DESCRIPTION / ACCORDIONS */
  .mp-desc details,.mp-faq details{border-bottom:1px solid var(--line);}
  .mp-desc summary,.mp-faq summary{list-style:none;cursor:pointer;font-family:var(--font-head);font-weight:500;font-size:16px;padding:15px 28px 15px 0;position:relative;}
  .mp-desc summary::-webkit-details-marker,.mp-faq summary::-webkit-details-marker{display:none;}
  .mp-desc summary:after,.mp-faq summary:after{content:"+";position:absolute;right:4px;top:13px;font-size:20px;color:var(--green);}
  .mp-desc details[open] summary:after,.mp-faq details[open] summary:after{content:"–";}
  .mp-acc-body{padding:0 0 16px;font-size:14px;line-height:1.6;color:var(--muted);}
  .mp-acc-body p{margin-bottom:10px;}
  .mp-table-scroll{overflow-x:auto;}
  .mp-sizetable,.mp-comptable{width:100%;border-collapse:collapse;font-size:12.5px;}
  .mp-sizetable th,.mp-sizetable td,.mp-comptable th,.mp-comptable td{border:1px solid var(--line);padding:8px 10px;text-align:center;}
  @media(max-width:560px){
    .mp-sizetable,.mp-comptable{font-size:10.5px;}
    .mp-sizetable th,.mp-sizetable td,.mp-comptable th,.mp-comptable td{padding:6px 4px;}
  }
  .mp-sizetable th,.mp-comptable th{background:var(--tint);font-family:var(--font-head);font-weight:500;}
  .mp-sizetable td:first-child,.mp-comptable td:first-child{text-align:left;font-weight:600;}
  .mp-comptable .y{color:var(--green-bright);font-weight:700;}
  .mp-comptable .n{color:var(--muted-2);}

  /* HOW IT WORKS / SEAMS */
  .mp-hiw-grid,.mp-seams-grid{display:grid;grid-template-columns:1fr;gap:18px;align-items:center;}
  .mp-hiw-img,.mp-seams-img{width:100%;border-radius:14px;}
  .mp-hiw-txt p,.mp-seams-txt p{font-size:14.5px;line-height:1.6;color:var(--muted);margin-bottom:12px;}
  .mp-checklist{list-style:none;display:flex;flex-direction:column;gap:9px;}
  .mp-checklist li{position:relative;padding-left:24px;font-size:14px;line-height:1.45;color:var(--ink);}
  .mp-checklist li:before{content:"✓";position:absolute;left:0;color:var(--green-bright);font-weight:800;}
  .mp-textcta{font-family:var(--font-head);font-weight:600;font-size:15px;color:var(--green);border-bottom:2px solid var(--green);padding-bottom:2px;}
  .mp-textcta.solid{background:var(--green);color:#fff;border:none;border-radius:10px;padding:13px 22px;}

  /* PESTS */
  .mp-pest-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:8px;}
  .mp-pest-grid figure{text-align:center;}
  .mp-pest-grid img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:12px;margin-bottom:7px;}
  .mp-pest-grid figcaption{font-family:var(--font-head);font-weight:500;font-size:14px;}

  /* STRIP / ECON */
  .mp-strip-img,.mp-econ-img{width:100%;border-radius:14px;margin:6px 0 12px;}
  .mp-econ-labels{display:flex;justify-content:space-between;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:16px;}

  /* WHY / KIT */
  .mp-why-grid,.mp-kit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:8px;}
  .mp-why-card,.mp-kit-card{background:var(--tint);border-radius:12px;padding:16px;}
  .mp-why-card h3,.mp-kit-card h3{font-size:16px;margin-bottom:6px;}
  .mp-why-card p,.mp-kit-card p{font-size:13px;line-height:1.5;color:var(--muted);}

  /* GUARANTEE */
  .mp-guar{text-align:center;}
  .mp-guar-badge{display:inline-block;border:3px solid var(--green);border-radius:50%;width:108px;height:108px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--green-deep);line-height:1.15;margin:0 auto 16px;}
  .mp-guar-badge strong{font-family:var(--font-head);font-size:30px;}

  /* REVIEWS */
  .mp-rev-summary{display:grid;grid-template-columns:1fr;gap:16px;background:var(--tint);border-radius:14px;padding:18px;margin-bottom:18px;}
  .mp-rev-score{display:flex;flex-direction:column;align-items:center;font-family:var(--font-head);font-size:40px;font-weight:600;}
  .mp-rev-bars{display:flex;flex-direction:column;gap:6px;}
  .mp-rev-bar{display:grid;grid-template-columns:30px 1fr 50px;align-items:center;gap:8px;font-size:12px;color:var(--muted);}
  .mp-rev-bar .mp-bar{height:8px;background:#e3e6df;border-radius:6px;overflow:hidden;}
  .mp-rev-bar .mp-bar i{display:block;height:100%;background:#f5a623;}
  .mp-rev-photos{display:flex;gap:9px;overflow-x:auto;margin-bottom:18px;scrollbar-width:none;}
  .mp-rev-photos::-webkit-scrollbar{display:none;}
  .mp-rev-photos img{flex:0 0 110px;width:110px;height:110px;object-fit:cover;border-radius:10px;}
  .mp-rev-cards{display:grid;grid-template-columns:1fr;gap:14px;}
  .mp-rev-card{border:1px solid var(--line);border-radius:12px;padding:16px;}
  .mp-rev-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:6px;}
  .mp-verified{font-size:11px;color:var(--green-deep);font-weight:600;}
  .mp-rev-card h4{font-family:var(--font-head);font-weight:500;font-size:15px;margin-bottom:6px;}
  .mp-rev-card p{font-size:13.5px;line-height:1.55;color:var(--muted);margin-bottom:8px;}
  .mp-rev-name{font-size:12.5px;font-weight:700;color:var(--ink);}

  /* STICKY */
  .mp-sticky{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);box-shadow:0 -4px 16px rgba(0,0,0,.08);transform:translateY(110%);transition:transform .25s;z-index:50;}
  .mp-sticky.show{transform:translateY(0);}
  .mp-sticky-inner{max-width:1080px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
  .mp-sticky-name{font-family:var(--font-head);font-weight:600;font-size:14px;display:block;}
  .mp-sticky-price{font-size:12px;color:var(--green-deep);font-weight:700;}
  .mp-sticky-btn{background:var(--green);color:#fff;border-radius:10px;padding:13px 26px;font-family:var(--font-head);font-weight:600;font-size:15px;white-space:nowrap;}

  @media(min-width:860px){
    .mp-hero-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:34px;align-items:start;}
    .mp-gallery{position:sticky;top:18px;}
    .mp h2{font-size:32px;}
    .mp-title{font-size:30px;}
    .mp-hiw-grid,.mp-seams-grid{grid-template-columns:1fr 1fr;gap:30px;}
    .mp-pest-grid,.mp-why-grid,.mp-kit-grid{grid-template-columns:repeat(4,1fr);}
    .mp-rev-summary{grid-template-columns:240px 1fr;align-items:center;}
    .mp-rev-cards{grid-template-columns:repeat(2,1fr);}
    .mp-bundles{flex-direction:row;}
    .mp-bundle{flex:1;}
  }
</style>

<script>
(function(){
  var MP={ perKit:{1:49.99,2:39.99,3:34.99}, compareKit:99.96, qty:2 };
  function $(id){return document.getElementById(id);}
  function money(n){return '$'+n.toFixed(2);}
  function kitRows(){return Array.prototype.slice.call(document.querySelectorAll('#mpKitSizes .mp-kitsize'));}
  function updateFit(el){ if(el && $('mpFit')) $('mpFit').textContent=el.dataset.fit||''; }
  function updateKitRows(){
    kitRows().forEach(function(row,i){
      row.hidden = i >= MP.qty;
      var lbl=row.querySelector('.mp-kitsize-label'); if(lbl) lbl.style.display=(MP.qty>1)?'block':'none';
    });
    var h=$('mpSizeHeading'); if(h) h.textContent=(MP.qty>1)?'Choose a size for each kit':'Select your size';
  }
  function render(){
    var pk=MP.perKit[MP.qty], total=pk*MP.qty, comp=MP.compareKit*MP.qty;
    var save=Math.round((1-pk/MP.compareKit)*100);
    $('mpPrice').textContent=money(total);
    $('mpCompare').textContent=money(comp);
    $('mpSave').textContent='SAVE '+save+'%';
    $('mpAtc').textContent='ADD '+(MP.qty===1?'TO CART':MP.qty+' KITS TO CART')+' — '+money(total);
    if($('mpStickyPrice'))$('mpStickyPrice').textContent=money(total);
  }
  // bundles
  document.querySelectorAll('#mpBundles .mp-bundle').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('#mpBundles .mp-bundle').forEach(function(x){x.classList.remove('active');});
      b.classList.add('active'); MP.qty=parseInt(b.dataset.qty); updateKitRows(); render();
    });
  });
  // per-kit sizes
  kitRows().forEach(function(row){
    row.querySelectorAll('.mp-size').forEach(function(b){
      b.addEventListener('click',function(){
        row.querySelectorAll('.mp-size').forEach(function(x){x.classList.remove('active');});
        b.classList.add('active'); updateFit(b);
      });
    });
  });
  // gallery thumbs
  document.querySelectorAll('#mpThumbs .mp-thumb').forEach(function(t){
    t.addEventListener('click',function(){
      document.querySelectorAll('#mpThumbs .mp-thumb').forEach(function(x){x.classList.remove('active');});
      t.classList.add('active');
      var full=t.getAttribute('data-full'); if(full)$('mpMainImg').src=full;
    });
  });
  // add to cart — one line item per chosen variant, quantities tallied across kits
  window.mpAddToCart=function(btn){
    var counts={};
    for(var i=0;i<MP.qty;i++){
      var row=document.querySelector('#mpKitSizes .mp-kitsize[data-kit="'+i+'"]');
      if(!row) continue;
      var act=row.querySelector('.mp-size.active'); if(!act) continue;
      var v=act.dataset.variant;
      if(!v || /REPLACE_ME/.test(String(v))){
        alert('Add your Shopify variant IDs in Theme Editor → MeshProtect Kit, then this button will add to cart.');
        return;
      }
      counts[v]=(counts[v]||0)+1;
    }
    var items=Object.keys(counts).map(function(v){return {id:v, quantity:counts[v]};});
    if(!items.length) return;
    var label=btn?btn.innerHTML:''; if(btn){btn.disabled=true;btn.innerHTML='Adding…';}
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})})
      .then(function(r){return r.json();})
      .then(function(d){ if(d.status){throw new Error(d.description||'Could not add to cart');} if(typeof openCartDrawer==='function'){openCartDrawer();} })
      .catch(function(e){ alert('Could not add to cart: '+e.message); })
      .then(function(){ if(btn){btn.disabled=false;btn.innerHTML=label;} });
  };
  window.mpScrollToBuy=function(){ var el=document.querySelector('.mp-hero'); if(el)el.scrollIntoView({behavior:'smooth'}); };
  window.mpOpenSizeChart=function(e){ if(e)e.preventDefault(); var d=$('mpSizeChart'); if(d){d.open=true; d.scrollIntoView({behavior:'smooth',block:'center'});} };
  // delivery date (5 business-ish days out)
  (function(){ var d=new Date(); d.setDate(d.getDate()+8); var opt={weekday:'short',month:'short',day:'numeric'}; var el=$('mpDeliveryDate'); if(el)el.textContent=d.toLocaleDateString('en-US',opt); })();
  // sticky bar
  var hero=document.querySelector('.mp-hero'), sticky=$('mpSticky');
  if(hero&&sticky){ window.addEventListener('scroll',function(){ var b=hero.getBoundingClientRect().bottom; sticky.classList.toggle('show', b<0); },{passive:true}); }
  updateKitRows(); render(); updateFit(document.querySelector('#mpKitSizes .mp-kitsize:not([hidden]) .mp-size.active'));
})();
</script>

{% schema %}
{
  "name": "MeshProtect Kit",
  "settings": [
    {"type":"header","content":"Checkout variant IDs (Black)"},
    {"type":"text","id":"variant_small","label":"Small — Shopify variant ID","default":"52726522413237"},
    {"type":"text","id":"variant_medium","label":"Medium — Shopify variant ID","default":"52726522446005"},
    {"type":"text","id":"variant_large","label":"Large — Shopify variant ID","default":"52726522478773"}
  ],
  "blocks": [
    {
      "type":"gallery_image",
      "name":"Hero gallery image",
      "settings":[
        {"type":"image_picker","id":"image","label":"Image (upload to override the URL below)"},
        {"type":"text","id":"image_url","label":"Image URL (used if no image uploaded)"},
        {"type":"text","id":"alt","label":"Alt text"}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {"name":"MeshProtect Kit"}
  ]
}
{% endschema %}
