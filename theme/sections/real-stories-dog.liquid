<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 820px;}

  .rs{background:var(--bg);padding:34px 0 38px;}
  .rs-wrap{max-width:1180px;margin:0 auto;}
  .rs-head{margin-bottom:22px;}
  .rs-rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
    scrollbar-width:none;padding:0 16px 4px;}
  .rs-rail::-webkit-scrollbar{display:none;}
  .rs-card{flex:0 0 85%;max-width:380px;scroll-snap-align:center;background:#fff;border:1px solid var(--line);
    border-radius:6px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 4px 18px rgba(0,0,0,.04);}
  .rs-img{width:100%;height:230px;background:var(--tint);overflow:hidden;}
  .rs-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .rs-body{padding:17px 18px 18px;display:flex;flex-direction:column;flex:1;}
  .rs-stars{color:var(--green-bright);letter-spacing:2px;font-size:16px;margin-bottom:9px;}
  .rs-quote{font-family:var(--font-body);font-size:14px;line-height:1.6;color:var(--ink);margin-bottom:13px;flex:1;}
  .rs-name{font-family:var(--font-head);font-weight:500;letter-spacing:normal;font-size:15px;color:#000;margin-bottom:11px;}
  .rs-pills{display:flex;flex-wrap:wrap;gap:7px;}
  .rs-pills span{font-family:var(--font-body);font-size:12px;font-weight:500;color:var(--green-deep);border:1px solid rgba(0,147,112,.4);
    background:var(--green-bright-soft);padding:5px 11px;border-radius:50px;}
  .rs-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px;}
  .rs-arrow{width:38px;height:38px;border-radius:50%;background:#fff;border:1px solid var(--line);color:var(--green-deep);
    font-size:20px;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.06);}
  .rs-dots{display:flex;flex-wrap:wrap;justify-content:center;gap:7px;}
  .rs-dots button{width:8px;height:8px;border-radius:50%;background:var(--line);transition:.2s;}
  .rs-dots button.active{background:var(--green-bright);transform:scale(1.3);}

  @media (min-width:760px){
    .rs-card{flex:0 0 360px;}
  }
</style>

<script>
(function(){
  var rail=document.getElementById('rsRail'); if(!rail)return;
  var cards=[].slice.call(rail.querySelectorAll('.rs-card'));
  var dotsWrap=document.getElementById('rsDots');
  var cur=0;
  cards.forEach(function(_,i){
    var b=document.createElement('button');b.setAttribute('aria-label','Story '+(i+1));
    if(i===0)b.classList.add('active');
    b.addEventListener('click',function(){go(i);});
    dotsWrap.appendChild(b);
  });
  var dots=[].slice.call(dotsWrap.children),raf;
  function go(i){cur=Math.max(0,Math.min(cards.length-1,i));cards[cur].scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});}
  document.getElementById('rsPrev').addEventListener('click',function(){go(cur-1);});
  document.getElementById('rsNext').addEventListener('click',function(){go(cur+1);});
  rail.addEventListener('scroll',function(){
    if(raf)cancelAnimationFrame(raf);
    raf=requestAnimationFrame(function(){
      var i=Math.round(rail.scrollLeft/(rail.scrollWidth/cards.length));
      cur=Math.max(0,Math.min(cards.length-1,i));
      dots.forEach(function(d,idx){d.classList.toggle('active',idx===cur);});
    });
  },{passive:true});
})();
</script>

