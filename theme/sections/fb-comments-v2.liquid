<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 900px;}

  .fbc{background:#fff;padding:34px 16px 38px;}
  .fbc-wrap{max-width:660px;margin:0 auto;}
  .fbc-head{margin-bottom:20px;}
  /* screenshot-look card: crisp border, soft drop shadow, everything contained */
  .fbc-card{max-width:530px;margin:0 auto 18px;background:#fff;border:1px solid #dfe2e8;border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);padding:14px 14px 12px;overflow:hidden;}
  .fbc-card,.fbc-card *{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;box-sizing:border-box;}
  .fbc-row{display:flex;gap:7px;align-items:flex-start;min-width:0;}
  .fbc-col{flex:1;min-width:0;}
  .fbc-avatar{flex:none;width:34px;height:34px;border-radius:50%;object-fit:cover;}
  .fbc-avatar--sm{width:26px;height:26px;}
  /* grey fb bubble */
  .fbc-bubble{display:inline-block;background:#f0f2f5;border-radius:18px;padding:8px 12px 9px;max-width:100%;}
  .fbc-name{display:block;font-weight:600;font-size:13px;color:#050505;margin-bottom:1px;}
  .fbc-follow{color:#1877f2;font-weight:600;font-size:12.5px;}
  .fbc-bubble p{font-size:14px;line-height:1.33;color:#050505;margin:0;overflow-wrap:break-word;word-break:break-word;}
  .fbc-tag{font-weight:600;}
  /* meta row below the bubble */
  .fbc-meta{display:flex;align-items:center;flex-wrap:wrap;gap:4px 12px;margin:4px 0 0 12px;font-size:12px;color:#65676b;min-width:0;}
  .fbc-time{font-weight:400;}
  .fbc-meta b{font-weight:600;cursor:pointer;white-space:nowrap;}
  .fbc-liked{color:#1877f2;}
  .fbc-send{color:#1877f2;}
  .fbc-reacts{margin-left:auto;display:inline-flex;align-items:center;flex:none;}
  .fbc-count{font-size:12px;color:#65676b;margin-left:3px;}
  .fbc-thumb,.fbc-heart{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;
    border:1.5px solid #fff;box-shadow:0 1px 2px rgba(0,0,0,.15);}
  .fbc-thumb{background:#1877f2;position:relative;z-index:1;}
  .fbc-heart{background:#f33e58;margin-left:-5px;}
  .fbc-thumb svg{width:9px;height:9px;}
  .fbc-heart svg{width:9px;height:9px;}
  /* threaded reply with connector elbow — tight indents so nothing runs off screen */
  .fbc-reply{position:relative;display:flex;gap:7px;align-items:flex-start;margin-top:8px;min-width:0;}
  .fbc-elbow{position:absolute;left:-20px;top:-6px;width:16px;height:20px;border-left:2px solid #e4e6eb;border-bottom:2px solid #e4e6eb;border-bottom-left-radius:10px;}
  /* second-level reply pulls back left so it never overflows on phones */
  .fbc-reply--deep{margin-left:-8px;}

  @media (max-width:420px){
    .fbc-card{padding:12px 10px 10px;}
    .fbc-bubble{padding:7px 10px 8px;}
    .fbc-bubble p{font-size:13px;}
    .fbc-name{font-size:12.5px;}
    .fbc-meta{gap:3px 9px;margin-left:10px;font-size:11.5px;}
    .fbc-avatar{width:30px;height:30px;}
    .fbc-avatar--sm{width:22px;height:22px;}
    .fbc-reply{gap:5px;}
    .fbc-reply--deep{margin-left:-14px;}
    .fbc-elbow{left:-15px;width:12px;}
  }
</style>

{% schema %}{"name":"Facebook Comments V2","settings":[]}{% endschema %}
