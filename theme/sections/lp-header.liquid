{%- comment -%}
  Sticky header: centered leaf logo + wordmark, cart bag right,
  deep green rule underneath. Cart opens the theme cart drawer.
{%- endcomment -%}
<header class="lph" id="lpHeader">
  <div class="lph-inner">
    <a href="{{ routes.root_url }}" class="lph-logo" aria-label="home">
      <svg class="lph-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C7.5 6 5.5 9.5 5.5 13.5A6.5 6.5 0 0 0 12 20a6.5 6.5 0 0 0 6.5-6.5C18.5 9.5 16.5 6 12 2z"/><path d="M12 6.5V20M12 11l3.2-2.4M12 14.5l-3.2-2.4"/></svg>
      <span class="lph-word">{{ section.settings.brand | default: 'PINEMOOR' }}</span>
    </a>
    <button class="lph-cart" onclick="openCartDrawer()" aria-label="Open cart">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-.8 12.2a1.8 1.8 0 0 1-1.8 1.8H7.6a1.8 1.8 0 0 1-1.8-1.8z"/><path d="M9 11V7a3 3 0 0 1 6 0v4" transform="translate(0,-1)"/></svg>
      <span class="cart-count" style="display:none">0</span>
    </button>
  </div>
</header>

<style>
.lph{position:sticky;top:0;z-index:50;background:#fff;border-bottom:2px solid var(--lpg-deep);}
.lph-inner{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:16px 18px;}
.lph-logo{grid-column:2;display:flex;align-items:center;gap:8px;color:var(--lpg-deep);}
.lph-leaf{width:24px;height:24px;}
.lph-word{font-family:var(--lp-head);font-weight:500;font-size:20px;letter-spacing:.22em;color:var(--lpg-deep);text-transform:uppercase;}
.lph-cart{grid-column:3;justify-self:end;position:relative;color:var(--lp-ink);display:flex;}
</style>

{% schema %}
{
  "name": "LP Header",
  "settings": [
    {"type":"text","id":"brand","label":"Brand wordmark","default":"PINEMOOR"}
  ]
}
{% endschema %}
