      <article class="rs-card">
        <div class="rs-img"><img src="{{ 'pm-3k98j8kt1deb1-641d1.webp' | asset_url }}" alt="Don M., Pinemoor customer" loading="lazy" decoding="async" width="800" height="600"></div>
