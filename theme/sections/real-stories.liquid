      <article class="rs-card">
        <div class="rs-img"><img src="{{ 'pm-man-hunting-with-shotgun-kneeling--8776e.webp' | asset_url }}" alt="Hunter with retriever" loading="lazy" decoding="async" width="612" height="408"></div>
