{%- liquid
  assign variant_1 = section.settings.variant_id_1 | default: '52748473401525'
  assign variant_2 = section.settings.variant_id_2 | default: '52748473335989'
  assign variant_3 = section.settings.variant_id_3 | default: '52748473368757'
  assign selling_plan_1 = section.settings.selling_plan_id_1 | default: '2686976181'
  assign selling_plan_2 = section.settings.selling_plan_id_2 | default: '2687074485'
  assign selling_plan_3 = section.settings.selling_plan_id_3 | default: '2687107253'
  assign hero_product = all_products[section.settings.product]
  assign use_product_images = false
  if hero_product and hero_product.images.size > 0
    assign use_product_images = true
  endif
  assign fb1 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoorproduct1_1highquality.png?v=1780285911&width=1100'
  assign fb2 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/lone_star_tick_drops.png?v=1779163464&width=1100'
  assign fb3 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_3_bottles_no_droppers.png?v=1780325112&width=1100'
  assign fb4 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_6_bottles_lined_up.png?v=1780325063&width=1100'
  assign btn_img_1 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_single_bottle_no_shadow.png?v=1780347368&width=240'
  assign btn_img_2 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_3_bottles_horizontal_1_1.png?v=1780794699&width=240'
  assign btn_img_3 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_6_bottles_closer_1_1_1.png?v=1780793623&width=240'
-%}

{%- comment -%}pm-lcp-preload: start the hero image download in the document head
  scan, before CSS or fonts resolve. This is the LCP element.{%- endcomment -%}
{%- unless use_product_images -%}
<link rel="preload" as="image" fetchpriority="high"
      href="{{ fb1 }}"
      imagesrcset="{{ fb1 | replace: 'width=1100', 'width=420' }} 420w, {{ fb1 | replace: 'width=1100', 'width=620' }} 620w, {{ fb1 | replace: 'width=1100', 'width=860' }} 860w, {{ fb1 }} 1100w"
      imagesizes="(min-width:760px) 560px, 100vw">
{%- endunless -%}

<section class="ph" id="product-hero">
  <div class="ph-wrap">

    <!-- GALLERY -->
    <div class="ph-gallery">
      <div class="ph-stage" id="phStage">
        <div class="ph-track" id="phTrack">
          {%- if use_product_images -%}
            {%- for img in hero_product.images limit: 7 -%}
            <div class="ph-slide{% if forloop.first %} active{% endif %}"><img src="{{ img | image_url: width: 1000 }}" srcset="{{ img | image_url: width: 420 }} 420w, {{ img | image_url: width: 620 }} 620w, {{ img | image_url: width: 860 }} 860w, {{ img | image_url: width: 1100 }} 1100w" sizes="(min-width:760px) 560px, 100vw" decoding="async" alt="{{ img.alt | escape | default: 'Pinemoor Tick Protection Drops for Dogs' }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %} width="{{ img.width }}" height="{{ img.height }}"></div>
            {%- endfor -%}
          {%- else -%}
            <div class="ph-slide active"><img src="{{ fb1 }}" srcset="{{ fb1 | replace: 'width=1100', 'width=420' }} 420w, {{ fb1 | replace: 'width=1100', 'width=620' }} 620w, {{ fb1 | replace: 'width=1100', 'width=860' }} 860w, {{ fb1 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor Tick Protection Drops bottle" loading="eager" fetchpriority="high" decoding="async"></div>
            <div class="ph-slide"><img src="{{ fb2 }}" srcset="{{ fb2 | replace: 'width=1100', 'width=420' }} 420w, {{ fb2 | replace: 'width=1100', 'width=620' }} 620w, {{ fb2 | replace: 'width=1100', 'width=860' }} 860w, {{ fb2 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor Organic Herbal Tick Protection Drops" loading="lazy" decoding="async"></div>
            <div class="ph-slide"><img src="{{ fb3 }}" srcset="{{ fb3 | replace: 'width=1100', 'width=420' }} 420w, {{ fb3 | replace: 'width=1100', 'width=620' }} 620w, {{ fb3 | replace: 'width=1100', 'width=860' }} 860w, {{ fb3 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor 3-bottle pack" loading="lazy" decoding="async"></div>
            <div class="ph-slide"><img src="{{ fb4 }}" srcset="{{ fb4 | replace: 'width=1100', 'width=420' }} 420w, {{ fb4 | replace: 'width=1100', 'width=620' }} 620w, {{ fb4 | replace: 'width=1100', 'width=860' }} 860w, {{ fb4 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor 6-bottle family bundle" loading="lazy" decoding="async"></div>
          {%- endif -%}
        </div>
        <button class="ph-arrow ph-arrow--prev" onclick="phMove(-1)" aria-label="Previous image">&#8249;</button>
        <button class="ph-arrow ph-arrow--next" onclick="phMove(1)" aria-label="Next image">&#8250;</button>
      </div>
      <div class="ph-thumbs" id="phThumbs">
        {%- if use_product_images -%}
          {%- for img in hero_product.images limit: 7 -%}
          <button class="ph-thumb{% if forloop.first %} active{% endif %}" onclick="phGo({{ forloop.index0 }})" aria-label="View image {{ forloop.index }}"><img src="{{ img | image_url: width: 160 }}" alt="" loading="lazy" decoding="async" width="52" height="52"></button>
          {%- endfor -%}
        {%- else -%}
          <button class="ph-thumb active" onclick="phGo(0)" aria-label="Image 1"><img src="{{ fb1 | replace: 'width=1100', 'width=140' }}" alt="" loading="lazy" decoding="async" width="52" height="52"></button>
          <button class="ph-thumb" onclick="phGo(1)" aria-label="Image 2"><img src="{{ fb2 | replace: 'width=1100', 'width=140' }}" alt="" loading="lazy" decoding="async" width="52" height="52"></button>
          <button class="ph-thumb" onclick="phGo(2)" aria-label="Image 3"><img src="{{ fb3 | replace: 'width=1100', 'width=140' }}" alt="" loading="lazy" decoding="async" width="52" height="52"></button>
          <button class="ph-thumb" onclick="phGo(3)" aria-label="Image 4"><img src="{{ fb4 | replace: 'width=1100', 'width=140' }}" alt="" loading="lazy" decoding="async" width="52" height="52"></button>
        {%- endif -%}
      </div>
    </div>

    <!-- INFO -->
    <div class="ph-info">

      <!-- Trustpilot-style rating (one thin line) -->
      <div class="ph-trust" aria-label="Rated 4.8 out of 5 on Trustpilot, 1,206 reviews">
        <span class="tp-logo"><svg class="tp-logo-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg>Trustpilot</span>
        <span class="tp-stars" aria-hidden="true">
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq tp-sq--p"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
        </span>
        <span class="tp-rating">Excellent</span>
        <span class="tp-meta"><strong>4.8</strong>&nbsp;&middot;&nbsp;1,206 reviews</span>
      </div>

      <h1 class="ph-title">Pinemoor&reg; Tick Protection Drops - (For Dogs)</h1>
      <p class="ph-subtitle">The flea &amp; tick repellent that protects your dog from the inside out &mdash; clinically-backed botanicals that shield against tick-borne diseases like Lyme, with no harsh chemicals or messy topicals.</p>

      <!-- Benefit grid -->
      <div class="ph-benefits">
        <div class="ph-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          <span>24-Hour Flea &amp; Tick Protection</span>
        </div>
        <div class="ph-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
          <span>Changes The Scent Ticks Hunt By</span>
        </div>
        <div class="ph-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M9 5.5A3.5 3.5 0 0 1 15 8c0 1-.3 1.8-.8 2.5M6 12c-1 1.5-1.5 3.2-1.5 5h11"/></svg>
          <span>No DEET, No Harsh Chemicals</span>
        </div>
        <div class="ph-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5C12 2.5 5 10 5 14.5a7 7 0 0 0 14 0C19 10 12 2.5 12 2.5z"/></svg>
          <span>1ml For Every 20 lbs Of Your<br>Dog&rsquo;s Weight, Every Morning</span>
        </div>
        <div class="ph-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14c1 1.3 2.2 2 3.5 2s2.5-.7 3.5-2"/><circle cx="9" cy="10" r=".6" fill="currentColor"/><circle cx="15" cy="10" r=".6" fill="currentColor"/></svg>
          <span>All-Natural Botanical Blend</span>
        </div>
        <div class="ph-benefit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M9 14.5L8 22l4-2 4 2-1-7.5"/></svg>
          <span>Lifetime Guarantee</span>
        </div>
      </div>

      <div class="ph-divider"></div>

      <!-- Dynamic price row -->
      <div class="ph-pricerow">
        <span class="ph-price" id="phPrice">$15.99<span class="ph-price-unit">/bottle</span></span>
        <span class="ph-strike" id="phStrike">$29.99</span>
        <span class="ph-sale" id="phSale">Summer Sale - Save 40%</span>
      </div>

      {%- capture buy_options -%}
      <div class="ph-options" id="phOptions">

        <label class="ph-opt" data-variant="{{ variant_1 }}" data-selling-plan="{{ selling_plan_1 }}" data-sub="34.99" data-onetime="44.99" data-save-otp="5" data-save-sub="20" data-prefix="">
          <span class="ph-opt-radio"></span>
          <img class="ph-opt-img" src="{{ btn_img_1 }}" alt="Pinemoor single bottle" loading="lazy" decoding="async" width="53" height="53">
          <div class="ph-opt-main">
            <span class="ph-opt-title">Buy One</span>
            <span class="ph-opt-save">1 Bottle</span>
          </div>
          <div class="ph-opt-right">
            <span class="ph-opt-price">$34.99<span class="ph-opt-unit">/bottle</span></span>
            <span class="ph-opt-strike">$44.99</span>
          </div>
        </label>

        <label class="ph-opt is-active" data-variant="{{ variant_2 }}" data-selling-plan="{{ selling_plan_2 }}" data-sub="15.99" data-onetime="29.99" data-save-otp="15" data-save-sub="40" data-prefix="">
          <span class="ph-opt-badge ph-opt-badge--ship">Free Shipping</span>
          <span class="ph-opt-radio"></span>
          <img class="ph-opt-img" src="{{ btn_img_2 }}" alt="Pinemoor 3 bottles" loading="lazy" decoding="async" width="53" height="53">
          <div class="ph-opt-main">
            <span class="ph-opt-title">Buy 2 Get 1 FREE</span>
            <span class="ph-opt-save">3 Bottles</span>
          </div>
          <div class="ph-opt-right">
            <span class="ph-opt-price">$15.99<span class="ph-opt-unit">/bottle</span></span>
            <span class="ph-opt-strike">$29.99</span>
          </div>
        </label>

        <label class="ph-opt" data-variant="{{ variant_3 }}" data-selling-plan="{{ selling_plan_3 }}" data-sub="10.99" data-onetime="19.99" data-save-otp="30" data-save-sub="60" data-prefix="6 Bottles &middot; ">
          <span class="ph-opt-badge ph-opt-badge--ship ph-opt-badge--nudge">FREE $39 Mystery Gift</span>
          <span class="ph-opt-radio"></span>
          <img class="ph-opt-img" src="{{ btn_img_3 }}" alt="Pinemoor family bundle, 6 bottles" loading="lazy" decoding="async" width="53" height="53">
          <div class="ph-opt-main">
            <span class="ph-opt-title">Buy 3 Get 3 FREE</span>
            <span class="ph-opt-save ph-opt-save--fit">6 Bottles &middot; Best Value</span>
          </div>
          <div class="ph-opt-right">
            <span class="ph-opt-price">$10.99<span class="ph-opt-unit">/bottle</span></span>
            <span class="ph-opt-strike">$19.99</span>
          </div>
        </label>

      </div>

      {%- endcapture -%}

      {%- if hero_product -%}
        {% form 'product', hero_product, id: 'pm-product-form' %}
          <input type="hidden" name="id" id="pm-variant-input" value="{{ variant_2 }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="selling_plan" id="pm-selling-plan" value="">
          {{ buy_options }}
          <div class="ph-delivery"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Order now for delivery by: <strong id="phDelivery">&mdash;</strong></div>
          <button type="button" class="ph-atc" id="phAtc" onclick="phAddToCart()">
            <span class="ph-atc-main">Add To Cart <span class="ph-atc-sep">|</span> <span id="phAtcPrice">$15.99/bottle</span></span>
            <span class="ph-atc-sub"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Lifetime Money-Back Guarantee</span>
          </button>
          <div class="ph-atc-trust">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Lifetime Guarantee</span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg> 100% USDA Organic</span>
          </div>
        {% endform %}
      {%- else -%}
        {{ buy_options }}
        <div class="ph-delivery"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Order now for delivery by: <strong id="phDelivery">&mdash;</strong></div>
        <button type="button" class="ph-atc" id="phAtc" onclick="phAddToCart()">
          <span class="ph-atc-main">Add To Cart <span class="ph-atc-sep">|</span> <span id="phAtcPrice">$15.99/bottle</span></span>
            <span class="ph-atc-sub"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Lifetime Money-Back Guarantee</span>
        </button>
        <div class="ph-atc-trust">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Lifetime Guarantee</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg> 100% USDA Organic</span>
        </div>
      {%- endif -%}

      <details class="ph-dir">
        <summary class="ph-dir-sum">Directions <span class="ph-dir-icon"></span></summary>
        <div class="ph-dir-body">
          <p>Add <strong>1ml for every 20 lbs of your dog&rsquo;s body weight</strong> to their food or water, preferably in the morning, for 24-hour protection against fleas and ticks.</p>
          <p>Use daily for the best season-long protection.</p>
        </div>
      </details>

    </div>
  </div>
</section>

<style>
  .ph{background:var(--bg);padding:14px 0 8px;}
  .ph-wrap{max-width:560px;margin:0 auto;padding:0 16px;}

  /* gallery — images fill, no off-colour border */
  .ph-gallery{margin-bottom:13px;}
  .ph-stage{position:relative;background:#F1F7F3;border-radius:0;overflow:hidden;margin:0 -16px;}
  .ph-track{display:flex;}
  .ph-slide{flex:0 0 100%;aspect-ratio:1/1;display:none;}
  .ph-slide.active{display:block;}
  .ph-slide img{width:100%;height:100%;object-fit:contain;}
  .ph-arrow{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;
    background:rgba(255,255,255,.85);color:var(--green-deep);font-size:20px;line-height:1;
    display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.1);z-index:2;}
  .ph-arrow--prev{left:8px;}.ph-arrow--next{right:8px;}
  .ph-thumbs{display:flex;gap:7px;margin-top:9px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;}
  .ph-thumbs::-webkit-scrollbar{display:none;}
  .ph-thumb{flex:0 0 52px;width:52px;height:52px;border-radius:7px;overflow:hidden;background:#fff;border:1.5px solid var(--line);}
  .ph-thumb img{width:100%;height:100%;object-fit:contain;}
  .ph-thumb.active{border-color:var(--green-bright);}

  /* trustpilot-style rating (one thin line) */
  .ph-trust{display:flex;align-items:center;gap:7px;margin-bottom:12px;flex-wrap:nowrap;white-space:nowrap;}
  .ph-trust .tp-logo{display:inline-flex;align-items:center;gap:3px;font-family:var(--font-body);font-weight:700;font-size:13px;color:#15251C;}
  .ph-trust .tp-logo-star{width:15px;height:15px;fill:#00b67a;}
  .ph-trust .tp-stars{display:inline-flex;gap:2px;}
  .ph-trust .tp-sq{width:16px;height:16px;background:#00b67a;display:inline-flex;align-items:center;justify-content:center;}
  .ph-trust .tp-sq svg{width:12px;height:12px;fill:#fff;}
  .ph-trust .tp-sq--p{background:linear-gradient(90deg,#00b67a 80%,var(--line) 80%);}
  .ph-trust .tp-rating{font-family:var(--font-body);font-weight:700;font-size:12.5px;color:#15251C;}
  .ph-trust .tp-meta{font-family:var(--font-body);font-size:12.5px;color:#15251C;}
  .ph-trust .tp-meta strong{font-weight:700;}

  /* title */
  .ph-title{font-family:var(--font-head);font-weight:500;font-size:22px;line-height:1.0;color:#000;letter-spacing:normal;margin-bottom:8px}
  .ph-subtitle{font-family:var(--font-body);font-size:15.5px;font-weight:400;color:#15251C;line-height:1.5;margin-bottom:15px;}

  /* benefits */
  .ph-benefits{display:grid;grid-template-columns:1fr 1fr;gap:9px 12px;margin-bottom:15px;}
  .ph-benefit{display:flex;align-items:center;gap:8px;font-family:var(--font-body);font-size:13.5px;font-weight:500;color:#000;line-height:1.2;}
  .ph-benefit svg{flex:none;width:19px;height:19px;color:var(--green-bright);}

  /* directions */
  .ph-directions{font-family:var(--font-body);font-size:13.5px;line-height:1.5;color:var(--green-deep);background:#EDF2EC;
    border-left:3px solid var(--green-bright);border-radius:6px;padding:11px 13px;margin-bottom:15px;}
  .ph-directions strong{font-weight:700;color:var(--green-deep);}

  .ph-divider{height:1px;background:var(--line);margin:2px 0 14px;}

  /* price row */
  .ph-pricerow{display:flex;align-items:center;gap:10px;margin-bottom:15px;flex-wrap:wrap;}
  .ph-price{font-family:var(--font-body);font-weight:700;font-size:15px;color:var(--green-bright);}
  .ph-price-unit{font-size:12px;font-weight:500;color:var(--green-bright);}
  .ph-strike{font-family:var(--font-body);font-size:13.5px;color:var(--muted-2);text-decoration:line-through;}
  .ph-sale{font-family:var(--font-body);background:var(--green-bright);color:#fff;font-weight:700;font-size:10.5px;padding:5px 10px;border-radius:5px;}

  /* buy options */
  .ph-options{display:flex;flex-direction:column;gap:12px;margin-bottom:15px;}
  .ph-opt{position:relative;display:flex;align-items:center;gap:12px;background:#fff;border:1.4px solid var(--line);
    border-radius:10px;padding:13px 14px;cursor:pointer;transition:border-color .15s,background .15s;}
  .ph-opt:hover{box-shadow:0 2px 7px rgba(16,40,28,.16);}
  .ph-opt.is-active{border-color:var(--green-bright);background:rgba(0,147,112,0.08);}
  .ph-opt-radio{flex:none;width:20px;height:20px;border-radius:50%;border:1.6px solid #C3D2C7;display:flex;align-items:center;justify-content:center;}
  .ph-opt.is-active .ph-opt-radio{border-color:var(--green-bright);}
  .ph-opt-radio::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--green-bright);transform:scale(0);transition:transform .15s;}
  .ph-opt.is-active .ph-opt-radio::after{transform:scale(1);}
  .ph-opt-img{flex:none;width:53px;height:53px;object-fit:contain;background:transparent;mix-blend-mode:multiply;}
  .ph-opt-main{flex:1;min-width:0;}
  .ph-opt-title{display:block;font-family:var(--font-head);font-weight:500;letter-spacing:normal;font-size:14.5px;color:#000;line-height:1.15;}
  .ph-opt-save{display:block;font-family:var(--font-body);font-size:13.5px;font-weight:400;color:var(--muted);margin-top:2px;}
  .ph-opt-save--fit{font-size:13.5px;white-space:nowrap;}
  .ph-opt-freeline{display:block;font-family:var(--font-body);font-size:11.5px;font-weight:700;color:var(--green-bright);margin-top:2px;}
  .ph-opt-right{flex:none;text-align:right;display:flex;flex-direction:column;align-items:flex-end;}
  .ph-opt-price{font-family:var(--font-body);font-weight:600;font-size:13px;color:var(--green);line-height:1.1;}
  .ph-opt-unit{font-size:10px;font-weight:500;color:var(--muted);}
  .ph-opt-strike{font-family:var(--font-body);font-size:11px;color:var(--muted-2);text-decoration:line-through;margin-top:2px;}
  .ph-opt-badge{position:absolute;top:0;right:13px;transform:translateY(-50%);font-family:var(--font-body);font-weight:600;
    font-size:10.5px;letter-spacing:.01em;color:#fff;padding:2px 10px;border-radius:11px;z-index:2;white-space:nowrap;}
  .ph-opt-badge--pop{background:var(--green-deep);}
  .ph-opt-badge--ship{background:var(--green-deep);}
  .ph-opt-badge--nudge{right:7px;}

  /* delivery */
  .ph-delivery{display:flex;align-items:center;justify-content:center;gap:7px;background:#EDF2EC;color:var(--green-deep);
    font-family:var(--font-body);font-size:13px;padding:10px;border-radius:6px;margin-bottom:12px;}
  .ph-delivery svg{flex:none;color:var(--green-bright);}
  .ph-delivery strong{font-weight:700;}

  /* atc — 3D button (heritage style) */
  .ph-atc{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:100%;
    background:var(--green);color:#fff;border-radius:8px;padding:18px 18px;margin-bottom:10px;
    box-shadow:0 5px 0 var(--green-deep), 0 8px 14px rgba(16,40,28,.30);
    transition:transform .12s ease, background .2s, box-shadow .12s ease;}
  .ph-atc:hover{background:var(--green-deep);}
  .ph-atc:active{transform:translateY(4px);box-shadow:0 1px 0 var(--green-deep), 0 2px 6px rgba(16,40,28,.28);}
  .ph-atc-main{font-family:var(--font-body);font-weight:500;font-size:14.5px;display:flex;align-items:center;justify-content:center;gap:8px;}
  .ph-atc-sep{opacity:.5;font-weight:400;}
  .ph-atc-sub{display:flex;align-items:center;justify-content:center;gap:6px;font-family:var(--font-body);font-weight:400;font-size:11px;opacity:.92;}
  .ph-atc-sub svg{flex:none;width:14px;height:14px;}
  .ph-atc-trust{display:flex;align-items:center;justify-content:center;flex-wrap:nowrap;gap:11px;margin-top:7px;margin-bottom:12px;font-family:var(--font-body);font-size:10px;font-weight:400;color:#15251C;white-space:nowrap;}
  .ph-atc-trust span{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}
  .ph-atc-trust svg{flex:none;width:15px;height:15px;color:#15251C;}

  @media (min-width:760px){
    .ph-wrap{max-width:1100px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;padding:14px 24px;}
    .ph-gallery{position:sticky;top:20px;}
    .ph-stage{margin:0;border-radius:10px;}
    .ph-title{font-size:27px;}
  }
  /* directions dropdown */
  .ph-dir{border:1.4px solid var(--line);border-radius:10px;margin:6px 0 10px;overflow:hidden;background:#fff;}
  .ph-dir-sum{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;
    padding:14px 16px;font-family:var(--font-body);font-weight:700;font-size:15.5px;color:#000;}
  .ph-dir-sum::-webkit-details-marker{display:none;}
  .ph-dir-icon{flex:none;width:16px;height:16px;position:relative;}
  .ph-dir-icon::before,.ph-dir-icon::after{content:"";position:absolute;background:var(--green-deep);border-radius:2px;transition:opacity .2s;}
  .ph-dir-icon::before{left:50%;top:0;width:2px;height:16px;transform:translateX(-50%);}
  .ph-dir-icon::after{top:50%;left:0;height:2px;width:16px;transform:translateY(-50%);}
  .ph-dir[open] .ph-dir-icon::before{opacity:0;}
  .ph-dir-body{padding:0 16px 16px;}
  .ph-dir-body p{font-family:var(--font-body);font-size:14px;line-height:1.6;color:var(--muted);margin-bottom:10px;}
  .ph-dir-body p:last-child{margin-bottom:0;}
  .ph-dir-body strong{color:var(--ink);font-weight:700;}


  /* carried over from the current live theme */
  .ph-sub{display:flex;align-items:center;gap:10px;background:#fff;border:1.4px solid var(--line);
    border-radius:10px;padding:11px 14px;margin-bottom:15px;cursor:pointer;}
  .ph-sub-main{flex:1;min-width:0;}
  .ph-sub-radio{flex:none;width:20px;height:20px;border-radius:50%;border:1.6px solid #C3D2C7;display:flex;align-items:center;justify-content:center;background:#fff;}
  .ph-sub-sub{display:block;font-family:var(--font-body);font-weight:400;font-size:11.5px;color:var(--muted);margin-top:2px;}
  .ph-sub-title{display:block;font-family:var(--font-body);font-weight:600;font-size:13px;color:#000;line-height:1.2;}
  .ph-sub.is-on .ph-sub-radio{border-color:var(--green-bright);}
</style>

<script>
(function(){
  /* ---------- gallery ---------- */
  var slides=[].slice.call(document.querySelectorAll('#phTrack .ph-slide'));
  var thumbs=[].slice.call(document.querySelectorAll('#phThumbs .ph-thumb'));
  var cur=0;
  window.phGo=function(n){
    if(!slides.length)return;
    slides[cur].classList.remove('active'); if(thumbs[cur])thumbs[cur].classList.remove('active');
    cur=((n%slides.length)+slides.length)%slides.length;
    slides[cur].classList.add('active'); if(thumbs[cur]){thumbs[cur].classList.add('active');thumbs[cur].scrollIntoView({inline:'center',block:'nearest'});}
  };
  window.phMove=function(d){phGo(cur+d);};
  var stage=document.getElementById('phStage');
  if(stage){var sx=0;
    stage.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
    stage.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)phMove(dx<0?1:-1);},{passive:true});
  }

  /* ---------- delivery date (+5 days) ---------- */
  (function(){
    var d=new Date();d.setDate(d.getDate()+5);
    var months=['January','February','March','April','May','June','July','August','September','October','November','December'];
    var day=d.getDate();
    var suf=(day%10===1&&day!==11)?'st':(day%10===2&&day!==12)?'nd':(day%10===3&&day!==13)?'rd':'th';
    var el=document.getElementById('phDelivery'); if(el) el.textContent=months[d.getMonth()]+' '+day+suf;
  })();

  /* ---------- bundle + subscribe pricing ---------- */
  var SUB_ON=true;
  var opts=[].slice.call(document.querySelectorAll('.ph-opt'));
  var subEl=document.getElementById('phSub');

  function fmt(n){return '$'+Number(n).toFixed(2);}

  function renderOpt(o){
    var sub=parseFloat(o.getAttribute('data-sub'));
    var one=parseFloat(o.getAttribute('data-onetime'));
    var main=SUB_ON?sub:one;
    var priceEl=o.querySelector('.ph-opt-price');
    if(priceEl)priceEl.innerHTML=fmt(main)+'<span class="ph-opt-unit">/bottle</span>';
    var strikeEl=o.querySelector('.ph-opt-strike');
    if(strikeEl){strikeEl.textContent=fmt(one);strikeEl.style.display=SUB_ON?'block':'none';}
  }

  function renderSelected(){
    var sel=document.querySelector('.ph-opt.is-active'); if(!sel)return;
    var sub=parseFloat(sel.getAttribute('data-sub'));
    var one=parseFloat(sel.getAttribute('data-onetime'));
    var main=SUB_ON?sub:one;
    var pr=document.getElementById('phPrice'); if(pr)pr.innerHTML=fmt(main)+'<span class="ph-price-unit">/bottle</span>';
    var strike=document.getElementById('phStrike'); if(strike){strike.textContent=fmt(one);strike.style.display=SUB_ON?'inline':'none';}
    var atc=document.getElementById('phAtcPrice'); if(atc)atc.textContent=fmt(main)+'/bottle';
    var saveVal=SUB_ON?sel.getAttribute('data-save-sub'):sel.getAttribute('data-save-otp');
    var sale=document.getElementById('phSale'); if(sale&&saveVal)sale.textContent='Summer Sale - Save '+saveVal+'%';
    var vinput=document.getElementById('pm-variant-input'); if(vinput)vinput.value=sel.getAttribute('data-variant');
    var spInput=document.getElementById('pm-selling-plan'); if(spInput)spInput.value=SUB_ON?(sel.getAttribute('data-selling-plan')||''):'';
  }

  function renderAll(){opts.forEach(renderOpt);renderSelected();}

  function selectOpt(o){
    opts.forEach(function(x){x.classList.remove('is-active');});
    o.classList.add('is-active');
    renderAll();
  }
  opts.forEach(function(o){o.addEventListener('click',function(e){e.preventDefault();selectOpt(o);});});

  function setSub(on){
    SUB_ON=on;
    if(subEl){subEl.classList.toggle('is-on',on);subEl.setAttribute('aria-pressed',on?'true':'false');}
    renderAll();
  }
  if(subEl){
    subEl.addEventListener('click',function(){setSub(!SUB_ON);});
    subEl.addEventListener('keydown',function(e){if(e.key===' '||e.key==='Enter'){e.preventDefault();setSub(!SUB_ON);}});
  }

  if(!document.querySelector('.ph-opt.is-active')&&opts.length)opts[0].classList.add('is-active');
  setSub(true);

  window.phAddToCart=function(){
    var sel=document.querySelector('.ph-opt.is-active'); if(!sel)return;
    var vid=sel.getAttribute('data-variant');
    if(!vid||vid.indexOf('REPLACE')!==-1){alert('Set your Shopify variant IDs in the section settings before going live.');return;}
    /* Pinemoor For Dogs is one-time purchase only — never send a selling plan */
    addToCart(parseInt(vid),1,document.getElementById('phAtc'),'');
  };
})();
</script>

