<style>
  .ph{background:#fff;padding:14px 0 8px;}
  .ph-wrap{max-width:560px;margin:0 auto;padding:0 16px;}

  /* gallery — images fill, no off-colour border */
  .ph-gallery{margin-bottom:13px;}
  .ph-stage{position:relative;background:#f3f3ef;border-radius:0;overflow:hidden;margin:0 -16px;}
  .ph-track{display:flex;}
  .ph-slide{flex:0 0 100%;aspect-ratio:1/1;display:none;}
  .ph-slide.active{display:block;}
  .ph-slide img{width:100%;height:100%;object-fit:contain;}
  /* older Safari has no aspect-ratio — reserve the square by hand so the
     gallery never collapses and reflows the page once the image lands */
  @supports not (aspect-ratio: 1 / 1){
    .ph-slide{position:relative;padding-top:100%;}
    .ph-slide img{position:absolute;top:0;left:0;}
  }
  /* fade is only armed by JS (.ph-fade) — with JS off the images just show */
  .ph-stage.ph-fade .ph-slide img{opacity:0;transition:opacity .25s ease;}
  .ph-stage.ph-fade .ph-slide img.pm-in{opacity:1;}
  .ph-thumb img{transition:opacity .2s ease;}
  .ph-arrow{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;
    background:rgba(255,255,255,.85);color:var(--green-deep);font-size:20px;line-height:1;
    display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.1);z-index:2;}
  .ph-arrow--prev{left:8px;}.ph-arrow--next{right:8px;}
  .ph-thumbs{display:flex;gap:7px;margin-top:9px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;}
  .ph-thumbs::-webkit-scrollbar{display:none;}
  .ph-thumb{flex:0 0 52px;width:52px;height:52px;border-radius:7px;overflow:hidden;background:#fff;border:1.5px solid var(--line);}
  .ph-thumb img{width:100%;height:100%;object-fit:contain;}
  .ph-thumb.active{border-color:var(--green-bright);}

  /* trustpilot-style rating (one thin line) */
  .ph-trust{display:flex;align-items:center;gap:7px;margin-bottom:12px;flex-wrap:nowrap;white-space:nowrap;}
  .ph-trust .tp-logo{display:inline-flex;align-items:center;gap:3px;font-family:var(--font-body);font-weight:700;font-size:13px;color:#191919;}
  .ph-trust .tp-logo-star{width:15px;height:15px;fill:#00b67a;}
  .ph-trust .tp-stars{display:inline-flex;gap:2px;}
  .ph-trust .tp-sq{width:16px;height:16px;background:#00b67a;display:inline-flex;align-items:center;justify-content:center;}
  .ph-trust .tp-sq svg{width:12px;height:12px;fill:#fff;}
  .ph-trust .tp-sq--p{background:linear-gradient(90deg,#00b67a 80%,#dcdce6 80%);}
  .ph-trust .tp-rating{font-family:var(--font-body);font-weight:700;font-size:12.5px;color:#191919;}
  .ph-trust .tp-meta{font-family:var(--font-body);font-size:12.5px;color:#191919;}
  .ph-trust .tp-meta strong{font-weight:700;}

  /* title */
  .ph-title{font-family:var(--font-head);font-weight:500;font-size:22px;line-height:1.2;color:#000;letter-spacing:normal;margin-bottom:8px;}
  .ph-subtitle{font-family:var(--font-body);font-size:15.5px;font-weight:400;color:#111;line-height:1.5;margin-bottom:15px;}

  /* benefits */
  .ph-benefits{display:grid;grid-template-columns:1fr 1fr;gap:9px 12px;margin-bottom:15px;}
  .ph-benefit{display:flex;align-items:center;gap:8px;font-family:var(--font-body);font-size:13.5px;font-weight:500;color:#000;line-height:1.2;}
  .ph-benefit svg{flex:none;width:19px;height:19px;color:var(--green-bright);}

  .ph-divider{height:1px;background:var(--line);margin:2px 0 14px;}

  /* price row */
  .ph-pricerow{display:flex;align-items:center;gap:10px;margin-bottom:15px;flex-wrap:wrap;}
  .ph-price{font-family:var(--font-body);font-weight:700;font-size:16px;color:var(--green-bright);}
  .ph-price-unit{font-size:13px;font-weight:500;color:var(--green-bright);}
  .ph-strike{font-family:var(--font-body);font-size:16px;color:var(--muted-2);text-decoration:line-through;}
  .ph-sale{font-family:var(--font-body);background:var(--green-bright);color:#fff;font-weight:700;font-size:12.5px;padding:5px 10px;border-radius:5px;}

  /* buy options — original card formatting with radio selection */
  .ph-options{display:flex;flex-direction:column;gap:12px;margin-bottom:15px;}
  .ph-opt{position:relative;display:flex;flex-direction:column;align-items:stretch;background:#fff;border:1.4px solid var(--line);
    border-radius:10px;padding:13px 14px;cursor:pointer;transition:border-color .15s,background .15s;}
  .ph-opt-row{display:flex;align-items:center;gap:12px;}
  .ph-opt:hover{border-color:#bcd0c4;}
  .ph-opt.is-active{border-color:var(--green-bright);background:rgba(0,147,112,0.08);}
  .ph-opt-radio{flex:none;width:20px;height:20px;border-radius:50%;border:1.6px solid #c2c9ba;display:flex;align-items:center;justify-content:center;}
  .ph-opt.is-active .ph-opt-radio{border-color:var(--green-bright);}
  .ph-opt-radio::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--green-bright);transform:scale(0);transition:transform .15s;}
  .ph-opt.is-active .ph-opt-radio::after{transform:scale(1);}
  .ph-opt-imgs{flex:none;display:flex;align-items:center;}
  .ph-opt-img{flex:none;width:53px;height:53px;object-fit:contain;background:transparent;mix-blend-mode:multiply;}
  .ph-opt-main{flex:1;min-width:0;}
  .ph-opt-title{display:block;font-family:var(--font-body);font-weight:600;font-size:14.5px;color:#000;line-height:1.15;white-space:nowrap;}
  .ph-opt-save{display:block;font-family:var(--font-body);font-size:13.5px;font-weight:400;color:var(--muted);margin-top:2px;white-space:nowrap;}
  .ph-opt-right{flex:none;text-align:right;display:flex;flex-direction:column;align-items:flex-end;}
  .ph-opt-price{font-family:var(--font-body);font-weight:600;font-size:14px;color:var(--green);line-height:1.1;}
  .ph-opt-unit{font-size:11.5px;font-weight:500;color:var(--muted);}
  .ph-opt-strike{font-family:var(--font-body);font-size:13px;color:var(--muted-2);text-decoration:line-through;margin-top:2px;}
  .ph-opt-badge{position:absolute;top:0;right:13px;transform:translateY(-50%);font-family:var(--font-body);font-weight:600;
    font-size:10.5px;letter-spacing:.01em;color:#fff;background:var(--green-deep);padding:2px 10px;border-radius:11px;z-index:2;white-space:nowrap;}

  /* gift dropdown inside selected card (Resilia style) */
  .ph-opt-gifts{max-height:0;overflow:hidden;transition:max-height .3s ease,margin-top .3s ease;}
  .ph-opt.is-active .ph-opt-gifts{max-height:260px;margin-top:11px;}
  .ph-opt-gifts-inner{border-top:1px solid rgba(9,89,70,.28);padding-top:11px;display:flex;flex-direction:column;gap:9px;}
  .ph-giftline{display:flex;align-items:flex-start;gap:8px;}
  .ph-giftline-check{flex:none;width:16px;height:16px;color:var(--green-bright);margin-top:1px;}
  .ph-giftline-ic{flex:none;width:26px;height:26px;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-top:-1px;}
  .ph-giftline-ic img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;}
  .ph-giftline-ic img.ph-giftline-ic--zoom{transform:scale(1.3);}
  .ph-giftline-txt{min-width:0;display:flex;flex-direction:column;gap:2px;}
  .ph-giftline-title{font-family:var(--font-body);font-weight:700;font-size:13px;color:#000;line-height:1.25;}
  .ph-giftline-sub{font-family:var(--font-body);font-weight:400;font-size:12px;color:#5c5c5c;line-height:1.25;}
  .ph-giftsep{display:flex;align-items:center;gap:10px;font-family:var(--font-body);font-weight:600;font-size:10.5px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--green-deep);margin:1px 0;}
  .ph-giftsep-line{flex:1;height:1px;background:rgba(9,89,70,.28);}

  /* subscribe & save toggle */
  .ph-subtog{display:flex;align-items:flex-start;gap:11px;background:#fff;border:1.4px dashed var(--green-bright);
    border-radius:10px;padding:12px 14px;cursor:pointer;margin:-3px 0 15px;transition:background .15s,border-color .15s;}
  .ph-subtog:hover{background:rgba(0,147,112,0.04);}
  .ph-subtog input{position:absolute;opacity:0;pointer-events:none;}
  .ph-subtog-box{flex:none;width:21px;height:21px;border-radius:5px;border:1.6px solid #c2c9ba;background:#fff;
    display:flex;align-items:center;justify-content:center;margin-top:1px;transition:background .15s,border-color .15s;}
  .ph-subtog-box svg{width:13px;height:13px;color:#fff;opacity:0;transform:scale(.5);transition:opacity .15s,transform .15s;}
  .ph-subtog.is-on{border-style:solid;background:rgba(0,147,112,0.08);}
  .ph-subtog.is-on .ph-subtog-box{background:var(--green-bright);border-color:var(--green-bright);}
  .ph-subtog.is-on .ph-subtog-box svg{opacity:1;transform:scale(1);}
  .ph-subtog-txt{min-width:0;display:flex;flex-direction:column;gap:2px;}
  .ph-subtog-title{font-family:var(--font-body);font-weight:700;font-size:14px;color:#000;line-height:1.2;}
  .ph-subtog-pct{color:var(--green-bright);}
  .ph-subtog-sub{font-family:var(--font-body);font-weight:400;font-size:12px;color:#5c5c5c;line-height:1.3;}

  /* delivery */
  .ph-delivery{display:flex;align-items:center;justify-content:center;gap:7px;background:#eaf6ec;color:var(--green-deep);
    font-family:var(--font-body);font-size:13px;padding:10px;border-radius:6px;margin:16px 0 12px;}
  .ph-delivery svg{flex:none;color:var(--green-bright);}
  .ph-delivery strong{font-weight:700;}

  /* atc — 3D button (heritage style) */
  .ph-atc{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:100%;background:var(--green-bar);color:#fff;
    border-radius:8px;padding:20px 18px;margin-bottom:10px;box-shadow:0 5px 0 #0b1c12, 0 8px 14px rgba(11,28,18,.34);transition:transform .12s ease, background .2s;}
  .ph-atc:hover{background:#234836;}
  .ph-atc:active{transform:translateY(4px);box-shadow:0 1px 0 #0b1c12, 0 2px 6px rgba(11,28,18,.3);}
  .ph-atc-main{font-family:var(--font-head);font-weight:500;font-size:17px;display:flex;align-items:center;justify-content:center;gap:8px;}
  .ph-atc-sep{opacity:.5;font-weight:400;}
  .ph-atc-sub{display:flex;align-items:center;justify-content:center;gap:6px;font-family:var(--font-body);font-weight:400;font-size:12px;opacity:.92;}
  .ph-atc-sub svg{flex:none;width:14px;height:14px;}
  .ph-atc-trust{display:flex;align-items:center;justify-content:center;flex-wrap:nowrap;gap:8px;margin-top:7px;margin-bottom:12px;font-family:var(--font-body);font-size:10px;font-weight:400;color:#111;white-space:nowrap;}

  .ph-atc-trust span{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;}
  .ph-atc-trust svg{flex:none;width:14px;height:14px;color:#111;}

  @media (min-width:760px){
    .ph-wrap{max-width:1100px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;padding:14px 24px;}
    .ph-gallery{position:sticky;top:20px;}
    .ph-stage{margin:0;border-radius:10px;}
    .ph-title{font-size:27px;}
  }
</style>

<script>
(function(){
  /* ---------- gallery ---------- */
  var slides=[].slice.call(document.querySelectorAll('#phTrack .ph-slide'));
  var thumbs=[].slice.call(document.querySelectorAll('#phThumbs .ph-thumb'));
  var cur=0;
  var stage=document.getElementById('phStage');
  var thumbRail=document.getElementById('phThumbs');

  /* Slide 1 is the LCP and loads eager; the rest are lazy so they never
     compete with it. Hidden lazy images are never fetched by the browser, so
     without help the second slide would be blank on the first swipe. Two
     things fix that: neighbours are promoted the moment you move, and the
     whole strip is promoted once the page has finished loading. */
  function phEager(im){
    if(!im)return;
    if(im.getAttribute('loading')==='lazy'){im.setAttribute('loading','eager');try{im.loading='eager';}catch(e){}}
  }
  function phPrime(i){
    if(!slides.length)return;
    var sl=slides[((i%slides.length)+slides.length)%slides.length];
    if(sl)phEager(sl.querySelector('img'));
  }
  function phWarmAll(){
    slides.forEach(function(sl){phEager(sl.querySelector('img'));});
    if(thumbRail)[].slice.call(thumbRail.querySelectorAll('img')).forEach(phEager);
  }
  if(document.readyState==='complete'){setTimeout(phWarmAll,200);}
  else{window.addEventListener('load',function(){setTimeout(phWarmAll,200);});}

  /* Cross-fade each frame in as it decodes instead of letting it snap in. */
  if(stage){
    stage.classList.add('ph-fade');
    slides.forEach(function(sl){
      var im=sl.querySelector('img'); if(!im)return;
      if(im.complete&&im.naturalWidth>0){im.classList.add('pm-in');return;}
      var show=function(){im.classList.add('pm-in');};
      im.addEventListener('load',show,{once:true});
      im.addEventListener('error',show,{once:true});
    });
    /* belt and braces: never leave a frame invisible */
    setTimeout(function(){slides.forEach(function(sl){var im=sl.querySelector('img');if(im)im.classList.add('pm-in');});},3000);
  }

  /* Scroll the thumb rail itself rather than scrollIntoView, which can drag
     the whole page around on iOS. */
  function phCenterThumb(el){
    if(!thumbRail||!el)return;
    var target=el.offsetLeft-(thumbRail.clientWidth-el.offsetWidth)/2;
    var max=thumbRail.scrollWidth-thumbRail.clientWidth;
    target=Math.max(0,Math.min(target,max));
    if(thumbRail.scrollTo)thumbRail.scrollTo({left:target,behavior:'smooth'});
    else thumbRail.scrollLeft=target;
  }

  window.phGo=function(n){
    if(!slides.length)return;
    slides[cur].classList.remove('active'); if(thumbs[cur])thumbs[cur].classList.remove('active');
    cur=((n%slides.length)+slides.length)%slides.length;
    slides[cur].classList.add('active');
    if(thumbs[cur]){thumbs[cur].classList.add('active');phCenterThumb(thumbs[cur]);}
    phPrime(cur+1);phPrime(cur-1);
  };
  window.phMove=function(d){phGo(cur+d);};
  phPrime(1);phPrime(-1);

  if(stage){var sx=0;
    stage.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
    stage.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)phMove(dx<0?1:-1);},{passive:true});
  }

  /* ---------- delivery date (+5 days) ---------- */
  (function(){
    var d=new Date();d.setDate(d.getDate()+5);
    var months=['January','February','March','April','May','June','July','August','September','October','November','December'];
    var day=d.getDate();
    var suf=(day%10===1&&day!==11)?'st':(day%10===2&&day!==12)?'nd':(day%10===3&&day!==13)?'rd':'th';
    var el=document.getElementById('phDelivery'); if(el) el.textContent=months[d.getMonth()]+' '+day+suf;
  })();

  /* ---------- bundle + subscribe & save toggle pricing ---------- */
  /* Unchecked (default) = one-time purchase. Checked = subscription. */
  var SUB_ON=true;   /* subscription-only page: no opt-out */
  var opts=[].slice.call(document.querySelectorAll('.ph-opt'));
  var subTog=document.getElementById('phSubTog');
  var subCheck=document.getElementById('phSubCheck');

  function fmt(n){return '$'+Number(n).toFixed(2);}

  function renderOpt(o){
    var sub=parseFloat(o.getAttribute('data-sub'));
    var one=parseFloat(o.getAttribute('data-onetime'));
    var main=SUB_ON?sub:one;
    var strike=SUB_ON?one:parseFloat(o.getAttribute('data-strike-otp')||one);
    var priceEl=o.querySelector('.ph-opt-price');
    if(priceEl)priceEl.innerHTML=fmt(main)+'<span class="ph-opt-unit">/bottle</span>';
    var strikeEl=o.querySelector('.ph-opt-strike');
    if(strikeEl){strikeEl.textContent=fmt(strike);strikeEl.style.display='block';}
    var amt=SUB_ON?o.getAttribute('data-amt-sub'):o.getAttribute('data-amt-otp');
    var tier=o.getAttribute('data-tier');
    var saveEl=o.querySelector('.ph-opt-save');
    if(saveEl&&amt&&tier)saveEl.innerHTML=(tier==='1'?'1 Bottle':tier+' Bottles')+' &middot; You save $'+amt;
  }

  function renderSelected(){
    var sel=document.querySelector('.ph-opt.is-active'); if(!sel)return;
    var sub=parseFloat(sel.getAttribute('data-sub'));
    var one=parseFloat(sel.getAttribute('data-onetime'));
    var main=SUB_ON?sub:one;
    var strikeVal=SUB_ON?one:parseFloat(sel.getAttribute('data-strike-otp')||one);
    var pr=document.getElementById('phPrice'); if(pr)pr.innerHTML=fmt(main)+'<span class="ph-price-unit">/bottle</span>';
    var strike=document.getElementById('phStrike'); if(strike){strike.textContent=fmt(strikeVal);strike.style.display='inline';}
    var atc=document.getElementById('phAtcPrice'); if(atc)atc.textContent=fmt(main)+'/bottle';
    var saveVal=SUB_ON?sel.getAttribute('data-save-sub'):sel.getAttribute('data-save-otp');
    var sale=document.getElementById('phSale'); if(sale&&saveVal)sale.textContent='Summer Sale - Save '+saveVal+'%';
    var freq=document.getElementById('phFreqTxt'); if(freq)freq.textContent='Monthly';
    var vinput=document.getElementById('pm-variant-input'); if(vinput)vinput.value=sel.getAttribute('data-variant');
    var spInput=document.getElementById('pm-selling-plan'); if(spInput)spInput.value=SUB_ON?(sel.getAttribute('data-selling-plan')||''):'';
  }

  function renderAll(){opts.forEach(renderOpt);renderSelected();}

  function selectOpt(o){
    opts.forEach(function(x){x.classList.remove('is-active');});
    o.classList.add('is-active');
    renderAll();
  }
  opts.forEach(function(o){o.addEventListener('click',function(e){e.preventDefault();selectOpt(o);});});

  if(subCheck){
    subCheck.checked=false;
    subCheck.addEventListener('change',function(){
      SUB_ON=subCheck.checked;
      if(subTog)subTog.classList.toggle('is-on',SUB_ON);
      renderAll();
    });
  }

  if(!document.querySelector('.ph-opt.is-active')&&opts.length)opts[0].classList.add('is-active');
  renderAll();

  /* only the main bundle product is added to cart — gifts are display-only */
  window.phAddToCart=function(){
    var sel=document.querySelector('.ph-opt.is-active'); if(!sel)return;
    var vid=sel.getAttribute('data-variant');
    if(!vid||vid.indexOf('REPLACE')!==-1){alert('Set your Shopify variant IDs in the section settings before going live.');return;}
    var sp=SUB_ON?(sel.getAttribute('data-selling-plan')||''):'';
    /* subscription checked but no plan configured: never fall through silently */
    if(SUB_ON&&!sp){alert('This bundle is missing its Selling Plan ID. Add it in the Product Hero section settings.');return;}
    addToCart(parseInt(vid),1,document.getElementById('phAtc'),sp);
  };
})();
</script>

