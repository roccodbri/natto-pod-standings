{%- liquid
  assign variant_1 = section.settings.variant_id_1 | default: '52514698887349'
  assign variant_2 = section.settings.variant_id_2 | default: '52515952001205'
  assign variant_3 = section.settings.variant_id_3 | default: '52579196403893'
  assign selling_plan_1 = section.settings.selling_plan_id_1 | default: '2686976181'
  assign selling_plan_2 = section.settings.selling_plan_id_2 | default: '2687074485'
  assign selling_plan_3 = section.settings.selling_plan_id_3 | default: '2687107253'
  assign gift_variant_6 = section.settings.gift_variant_6 | default: '52748083724469'
  assign hero_product = all_products[section.settings.product]
  assign use_product_images = false
  if hero_product and hero_product.images.size > 0
    assign use_product_images = true
  endif
  assign fb1 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoorproduct1_1highquality.png?v=1780285911&width=1100'
  assign fb2 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/lone_star_tick_drops.png?v=1779163464&width=1100'
  assign fb3 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_3_bottles_no_droppers.png?v=1780325112&width=1100'
  assign fb4 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/pinemoor_6_bottles_lined_up.png?v=1780325063&width=1100'
  assign btn_img_1 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260713_233510_2fd30a75-bcc7-4fe8-a2b9-d92c9085bdba.png?v=1783998610&width=240'
  assign btn_img_2 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260708_005146_a373486f-5728-4345-bef3-e9921f2ba859.png?v=1783998646&width=240'
  assign btn_img_3 = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/hf_20260714_025548_3e90ab15-b2fa-44f2-9aff-b461f6071bc9.png?v=1783998595&width=240'
  assign ship_icon = 'https://cdn.shopify.com/s/files/1/1009/5601/2725/files/Image_21.png?v=1783475744&width=288'
  assign mystery_icon = 'pm-mystery-gift-box-icon-featuring-wr-1a901.webp' | asset_url
  assign insurance_icon = 'pm-shipping-insurance-00043-175249626-01b81.webp' | asset_url
-%}

{%- comment -%}pm-lcp-preload: start the hero image download in the document head
  scan, before CSS or fonts resolve. This is the LCP element.{%- endcomment -%}
{%- if use_product_images -%}
  {%- assign lcp_img = hero_product.images[0] -%}
<link rel="preload" as="image" fetchpriority="high"
      href="{{ lcp_img | image_url: width: 1000 }}"
      imagesrcset="{{ lcp_img | image_url: width: 420 }} 420w, {{ lcp_img | image_url: width: 620 }} 620w, {{ lcp_img | image_url: width: 860 }} 860w, {{ lcp_img | image_url: width: 1100 }} 1100w"
      imagesizes="(min-width:760px) 560px, 100vw">
{%- else -%}
<link rel="preload" as="image" fetchpriority="high"
      href="{{ fb1 }}"
      imagesrcset="{{ fb1 | replace: 'width=1100', 'width=420' }} 420w, {{ fb1 | replace: 'width=1100', 'width=620' }} 620w, {{ fb1 | replace: 'width=1100', 'width=860' }} 860w, {{ fb1 }} 1100w"
      imagesizes="(min-width:760px) 560px, 100vw">
{%- endif -%}

<section class="ph" id="product-hero">
  <div class="ph-wrap">

    <!-- GALLERY -->
    <div class="ph-gallery">
      <div class="ph-stage" id="phStage">
        <div class="ph-track" id="phTrack">
          {%- if use_product_images -%}
            {%- for img in hero_product.images limit: 8 -%}
            <div class="ph-slide{% if forloop.first %} active{% endif %}"><img src="{{ img | image_url: width: 1000 }}" srcset="{{ img | image_url: width: 420 }} 420w, {{ img | image_url: width: 620 }} 620w, {{ img | image_url: width: 860 }} 860w, {{ img | image_url: width: 1100 }} 1100w" sizes="(min-width:760px) 560px, 100vw" decoding="async" alt="{{ img.alt | escape | default: 'Pinemoor Tick Protection Drops' }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %} width="{{ img.width }}" height="{{ img.height }}"></div>
            {%- endfor -%}
          {%- else -%}
            <div class="ph-slide active"><img src="{{ fb1 }}" srcset="{{ fb1 | replace: 'width=1100', 'width=420' }} 420w, {{ fb1 | replace: 'width=1100', 'width=620' }} 620w, {{ fb1 | replace: 'width=1100', 'width=860' }} 860w, {{ fb1 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor Tick Protection Drops bottle" loading="eager" fetchpriority="high" decoding="async" width="1100" height="1100"></div>
            <div class="ph-slide"><img src="{{ fb2 }}" srcset="{{ fb2 | replace: 'width=1100', 'width=420' }} 420w, {{ fb2 | replace: 'width=1100', 'width=620' }} 620w, {{ fb2 | replace: 'width=1100', 'width=860' }} 860w, {{ fb2 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor Organic Herbal Tick Protection Drops" loading="lazy" decoding="async" width="1100" height="1100"></div>
            <div class="ph-slide"><img src="{{ fb3 }}" srcset="{{ fb3 | replace: 'width=1100', 'width=420' }} 420w, {{ fb3 | replace: 'width=1100', 'width=620' }} 620w, {{ fb3 | replace: 'width=1100', 'width=860' }} 860w, {{ fb3 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor 3-bottle pack" loading="lazy" decoding="async" width="1100" height="1100"></div>
            <div class="ph-slide"><img src="{{ fb4 }}" srcset="{{ fb4 | replace: 'width=1100', 'width=420' }} 420w, {{ fb4 | replace: 'width=1100', 'width=620' }} 620w, {{ fb4 | replace: 'width=1100', 'width=860' }} 860w, {{ fb4 }} 1100w" sizes="(min-width:760px) 560px, 100vw" alt="Pinemoor 6-bottle family bundle" loading="lazy" decoding="async" width="1100" height="1100"></div>
          {%- endif -%}
        </div>
        <button class="ph-arrow ph-arrow--prev" onclick="phMove(-1)" aria-label="Previous image">&#8249;</button>
        <button class="ph-arrow ph-arrow--next" onclick="phMove(1)" aria-label="Next image">&#8250;</button>
      </div>
      <div class="ph-thumbs" id="phThumbs">
        {%- if use_product_images -%}
          {%- for img in hero_product.images limit: 8 -%}
          <button class="ph-thumb{% if forloop.first %} active{% endif %}" onclick="phGo({{ forloop.index0 }})" aria-label="View image {{ forloop.index }}"><img src="{{ img | image_url: width: 160 }}" alt="" loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}" fetchpriority="low" decoding="async" width="52" height="52"></button>
          {%- endfor -%}
        {%- else -%}
          <button class="ph-thumb active" onclick="phGo(0)" aria-label="Image 1"><img src="{{ fb1 | replace: 'width=1100', 'width=140' }}" alt="" loading="eager" fetchpriority="low" decoding="async" width="52" height="52"></button>
          <button class="ph-thumb" onclick="phGo(1)" aria-label="Image 2"><img src="{{ fb2 | replace: 'width=1100', 'width=140' }}" alt="" loading="eager" fetchpriority="low" decoding="async" width="52" height="52"></button>
          <button class="ph-thumb" onclick="phGo(2)" aria-label="Image 3"><img src="{{ fb3 | replace: 'width=1100', 'width=140' }}" alt="" loading="eager" fetchpriority="low" decoding="async" width="52" height="52"></button>
          <button class="ph-thumb" onclick="phGo(3)" aria-label="Image 4"><img src="{{ fb4 | replace: 'width=1100', 'width=140' }}" alt="" loading="eager" fetchpriority="low" decoding="async" width="52" height="52"></button>
        {%- endif -%}
      </div>
    </div>

    <!-- INFO -->
    <div class="ph-info">

      <!-- Trustpilot-style rating (one thin line) -->
      <div class="ph-trust" aria-label="Rated 4.8 out of 5 on Trustpilot, 1,206 reviews">
        <span class="tp-logo"><svg class="tp-logo-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg>Trustpilot</span>
        <span class="tp-stars" aria-hidden="true">
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
          <span class="tp-sq tp-sq--p"><svg viewBox="0 0 24 24"><path d="M12 2l2.94 6.26 6.86.62-5.18 4.56 1.54 6.7L12 17.9 5.84 20.7l1.54-6.7L2.2 8.88l6.86-.62z"/></svg></span>
        </span>
        <span class="tp-rating">Excellent</span>
        <span class="tp-meta"><strong>4.8</strong>&nbsp;&middot;&nbsp;1,206 reviews</span>
      </div>

      <h1 class="ph-title">Pinemoor&reg; Tick Protection Drops</h1>
