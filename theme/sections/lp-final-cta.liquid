{%- liquid
  assign variant_1 = section.settings.variant_id_1 | default: '52810262577333'
  assign variant_2 = section.settings.variant_id_2 | default: '52810262610101'
  assign variant_3 = section.settings.variant_id_3 | default: '52810262642869'
-%}
{%- comment -%}
  Closing purchase block: same bundle cards + delivery row + ATC as the hero
  (shared [data-lp-offers] script from lp-hero handles both instances).
{%- endcomment -%}
<section class="lpe">
  <div class="lp-wrap">
    <h2 class="lp-h2 lp-h2--c">Pick Your Bundle</h2>
    <p class="lp-sub lp-sub--c">Stock up for the season &mdash; bundles ship free.</p>
    <div class="lpe-offers">
      {% render 'lp-offers', uid: 'final', variant_1: variant_1, variant_2: variant_2, variant_3: variant_3 %}
    </div>
  </div>
</section>

<style>
.lpe{background:#fff;padding:44px 0 54px;}
.lpe-offers{margin-top:30px;}
</style>

{% schema %}
{
  "name": "LP Final CTA",
  "settings": [
    {"type":"text","id":"variant_id_1","label":"Variant ID — Buy One","default":"52810262577333"},
    {"type":"text","id":"variant_id_2","label":"Variant ID — Buy 2 Get 1 Free","default":"52810262610101"},
    {"type":"text","id":"variant_id_3","label":"Variant ID — Buy 3 Get 3 Free","default":"52810262642869"}
  ]
}
{% endschema %}
