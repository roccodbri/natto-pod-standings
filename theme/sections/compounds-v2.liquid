<section class="cp" id="pm-compounds">
  <div class="cp-wrap">
    <div class="cp-head">
      <span class="cp-badge">The Science</span>
      <h2 class="cp-h">6 Clinically-Studied Compounds <span class="accent">Doing Different Jobs</span></h2>
      <p class="cp-sub">Ticks don&rsquo;t see you &mdash; they <strong>smell</strong> you. Each of Pinemoor&rsquo;s six botanicals quiets a different scent signal your skin gives off, so a tick never gets a clear read on you.</p>
    </div>

    <div class="cp-rail" id="cpRail">

      <article class="cp-card">
        <div class="cp-img"><img src="{{ 'pm-oregeno-oil-19258.webp' | asset_url }}" alt="Oregano Extract" loading="lazy" decoding="async" width="560" height="340"></div>
        <h3 class="cp-name">Oregano Extract</h3>
        <p class="cp-text">Its active compound, carvacrol, comes out through your skin and dampens the scent ticks track. In lab studies, carvacrol repelled ticks as well as DEET.</p>
      </article>

      <article class="cp-card">
        <div class="cp-img"><img src="{{ 'pm-images-9ead1.webp' | asset_url }}" alt="Carvacrol" loading="lazy" decoding="async" width="560" height="420"></div>
        <h3 class="cp-name">Carvacrol</h3>
        <p class="cp-text">Found in both oregano and thyme, it&rsquo;s the botanical shown in studies to repel ticks as well as DEET &mdash; and Pinemoor gives it to you from two sources.</p>
      </article>

      <article class="cp-card">
        <div class="cp-img"><img src="{{ 'pm-intro-1628012061-de521.webp' | asset_url }}" alt="Garlic Extract" loading="lazy" decoding="async" width="560" height="314"></div>
        <h3 class="cp-name">Garlic Extract</h3>
        <p class="cp-text">Its sulfur compounds leave the body through your skin and overwrite your &ldquo;human&rdquo; scent. Studies measured them coming off the skin after eating garlic &mdash; and garlic-eaters got fewer tick bites.</p>
      </article>

      <article class="cp-card">
        <div class="cp-img"><img src="{{ 'pm-carvacrol-13b1803e-15a6-4a5b-8d6d--8d7d4.webp' | asset_url }}" alt="Thyme" loading="lazy" decoding="async" width="478" height="418"></div>
        <h3 class="cp-name">Thyme</h3>
        <p class="cp-text">Concentrated in thymol, which lingers in your skin&rsquo;s natural oils &mdash; extending the protective window through long days in the grass and timber.</p>
      </article>

      <article class="cp-card">
        <div class="cp-img"><img src="{{ 'pm-soursop-fruit-899698968-aca3d.webp' | asset_url }}" alt="Soursop" loading="lazy" decoding="async" width="560" height="373"></div>
        <h3 class="cp-name">Soursop</h3>
        <p class="cp-text">Its plant compounds shift your skin chemistry so you stop reading as food to a tick &mdash; studied as a natural insect repellent and deterrent.</p>
      </article>

      <article class="cp-card">
        <div class="cp-img"><img src="{{ 'pm-tbk4mufjgzz4jsbw4k6raj-54c29.webp' | asset_url }}" alt="Pau D'Arco" loading="lazy" decoding="async" width="560" height="420"></div>
        <h3 class="cp-name">Pau D'Arco</h3>
        <p class="cp-text">Menthol-rich vapor interferes with the CO&#8322; and scent cues a tick uses to detect a host at close range &mdash; turning you off before contact.</p>
      </article>

    </div>

    <div class="cp-nav">
      <button class="cp-arrow" id="cpPrev" aria-label="Previous">&#8249;</button>
      <div class="cp-dots" id="cpDots"></div>
      <button class="cp-arrow" id="cpNext" aria-label="Next">&#8250;</button>
    </div>
  </div>
</section>

<style>
  /* Skip layout+paint for this section while it is far offscreen.
     `auto` lets the browser swap in the real height after first render. */
  #shopify-section-{{ section.id }}{content-visibility:auto;contain-intrinsic-size:auto 760px;}

  .cp{background:#fff;padding:34px 0 36px;}
  .cp-wrap{max-width:1180px;margin:0 auto;}
  .cp-head{text-align:center;padding:0 18px;margin-bottom:22px;}
  .cp-badge{display:inline-block;color:var(--green-bright);font-family:var(--font-head);font-weight:500;font-size:16px;margin-bottom:10px;letter-spacing:.02em;}
  .cp-h{font-family:var(--font-head);font-weight:500;font-size:26px;line-height:1.18;text-align:center;color:#000;
    margin-bottom:12px;letter-spacing:normal;}
  .cp-sub{font-family:var(--font-body);font-size:14.5px;line-height:1.6;color:var(--muted);max-width:600px;margin:0 auto;text-align:center;}
  .cp-sub strong{color:#000;font-weight:700;}
  .cp-rail{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
    scrollbar-width:none;padding:0 16px 4px;}
  .cp-rail::-webkit-scrollbar{display:none;}
  .cp-card{flex:0 0 78%;max-width:300px;scroll-snap-align:center;background:#fff;border:1px solid var(--line);
    border-radius:10px;overflow:hidden;padding:0 0 18px;}
  .cp-img{width:100%;aspect-ratio:1/1;overflow:hidden;background:var(--tint);}
  .cp-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .cp-name{font-family:var(--font-head);font-weight:500;font-size:19px;text-align:center;color:#000;margin:16px 16px 8px;}
  .cp-text{font-family:var(--font-body);font-size:14px;line-height:1.55;color:var(--muted);text-align:center;padding:0 18px;}
  .cp-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px;}
  .cp-arrow{width:38px;height:38px;border-radius:50%;background:#fff;border:1px solid var(--line);color:var(--green-deep);
    font-size:20px;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.06);}
  .cp-dots{display:flex;gap:7px;}
  .cp-dots button{width:8px;height:8px;border-radius:50%;background:#cfd6cb;transition:.2s;}
  .cp-dots button.active{background:var(--green-bright);transform:scale(1.3);}

  @media (min-width:760px){
    .cp-h{font-size:32px;margin-bottom:30px;}
    .cp-card{flex:0 0 270px;}
  }
</style>

<script>
(function(){
  var rail=document.getElementById('cpRail'); if(!rail)return;
  var cards=[].slice.call(rail.querySelectorAll('.cp-card'));
  var dotsWrap=document.getElementById('cpDots');
  var cur=0;
  cards.forEach(function(_,i){
    var b=document.createElement('button');b.setAttribute('aria-label','Card '+(i+1));
    if(i===0)b.classList.add('active');
    b.addEventListener('click',function(){go(i);});
    dotsWrap.appendChild(b);
  });
  var dots=[].slice.call(dotsWrap.children);
  function go(i){cur=Math.max(0,Math.min(cards.length-1,i));cards[cur].scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});}
  document.getElementById('cpPrev').addEventListener('click',function(){go(cur-1);});
  document.getElementById('cpNext').addEventListener('click',function(){go(cur+1);});
  var raf;
  rail.addEventListener('scroll',function(){
    if(raf)cancelAnimationFrame(raf);
    raf=requestAnimationFrame(function(){
      var i=Math.round(rail.scrollLeft/(rail.scrollWidth/cards.length));
      cur=Math.max(0,Math.min(cards.length-1,i));
      dots.forEach(function(d,idx){d.classList.toggle('active',idx===cur);});
    });
  },{passive:true});
})();
</script>

