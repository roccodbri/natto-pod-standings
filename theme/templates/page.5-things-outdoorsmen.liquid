    .proof .laurel{width:56px;height:48px}
    .proof p{font-size:14.5px}
    .reviews{padding:6px 22px 58px}
    .reviews .rsub{font-size:17px}
    .rcard{flex-basis:82%;max-width:82%;padding:20px}
    .bottom{padding:52px 24px}
    .bottom-in{grid-template-columns:1fr;gap:26px}
    .bottom p{font-size:17px}
