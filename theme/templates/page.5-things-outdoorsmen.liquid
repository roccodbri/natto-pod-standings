  .rbox .rt{font-size:14.5px;color:#2a3a30;white-space:nowrap}
  .rbox .rt b{font-weight:700;color:#12241d}
  h1.hero-h{font-family:var(--display);font-weight:500;font-size:clamp(42px,10.8vw,62px);line-height:1.14;letter-spacing:normal;color:var(--ink);margin-bottom:15px;}
  .hero-sub{font-family:var(--sans);font-size:20px;font-weight:400;color:#001f17;max-width:460px;margin-bottom:24px;line-height:1.25}
