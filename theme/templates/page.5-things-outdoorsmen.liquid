  footer.ftr p{margin-bottom:14px}
  footer.ftr .up{text-transform:uppercase;letter-spacing:.04em;color:#c3ddce}


  /* == CTA affordances ============================================ */
  .btn .arrow,.btn-lime .arrow{margin-left:9px;font-size:1.04em;line-height:1;display:inline-block;
    transform:translateX(0);transition:transform .25s ease}
  .btn:hover .arrow,.btn-lime:hover .arrow{transform:translateX(5px)}
  .btn,.btn-lime,.ilink{cursor:pointer}
  @keyframes ctaPulse{0%,100%{box-shadow:0 0 0 0 rgba(9,89,70,.30)}55%{box-shadow:0 0 0 13px rgba(9,89,70,0)}}
  .btn-pulse{animation:ctaPulse 2.8s ease-out infinite}
  @media(prefers-reduced-motion:reduce){.btn-pulse{animation:none}.btn .arrow,.btn-lime .arrow{transition:none}}

  /* the one CTA style used in-body: subtle inline link, trailing pointer */
  .ilink{color:var(--green);font-weight:700;text-decoration:underline;text-decoration-thickness:2px;
    text-underline-offset:3px;text-decoration-color:#9ccdb4;transition:color .2s,text-decoration-color .2s}
  .ilink:hover,.ilink:active{color:var(--green2);text-decoration-color:var(--green)}
  .ilink .ptr{text-decoration:none;display:inline-block;margin-left:4px}

  @media(max-width:860px){
