  .guar svg{width:16px;height:16px;color:var(--green);flex:none}
  .hero-r{position:relative;min-height:560px;overflow:hidden}
  .hero-r>img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  .pill{position:absolute;top:14px;left:14px;background:var(--lime);color:var(--green);font-weight:700;font-size:11px;
    letter-spacing:.05em;padding:5px 12px;border-radius:20px;z-index:2;line-height:1.2}

  /* protection reason: image + compact quote card (quote never overlaps the image) */
  .protect-media .item-img{margin-bottom:12px}
  .qcard{background:#fff;border:1px solid #e4ede1;border-left:4px solid var(--green);border-radius:10px;padding:13px 16px}
  .qcard .q-top{display:flex;align-items:center;gap:9px;margin-bottom:6px;flex-wrap:wrap}
  .qcard .q-stars{color:var(--star);letter-spacing:1px;font-size:13px}
  .qcard .q-name{font-size:12.5px;color:#5b6b60;font-weight:700}
  .qcard .q-text{font-size:14.5px;line-height:1.4;font-weight:500;color:#22332a;margin:0}
