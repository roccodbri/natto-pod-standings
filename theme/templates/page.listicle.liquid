        <rect x="170" y="27" width="403" height="20" rx="4" fill="#123F27"/><text x="567" y="41" text-anchor="end" font-size="12.5" font-weight="700" fill="#FFFFFF">95%</text>
        <text x="162" y="74" text-anchor="end" font-size="13" font-weight="700" fill="#15251C">Thymol (Thyme)</text>
        <rect x="170" y="61" width="391" height="20" rx="4" fill="#123F27"/><text x="555" y="75" text-anchor="end" font-size="12.5" font-weight="700" fill="#FFFFFF">92%</text>
        <text x="162" y="108" text-anchor="end" font-size="13" font-weight="700" fill="#15251C">Geraniol (Geranium)</text>
        <rect x="170" y="95" width="375" height="20" rx="4" fill="#3F7A4F"/><text x="539" y="109" text-anchor="end" font-size="12.5" font-weight="700" fill="#fff">88%</text>
