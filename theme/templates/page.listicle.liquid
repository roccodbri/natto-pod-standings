        <rect x="170" y="149" width="309" height="20" rx="4" fill="#C3D2C7"/><text x="473" y="163" text-anchor="end" font-size="12.5" font-weight="700" fill="#56695E">72%</text>
        <text x="162" y="196" text-anchor="end" font-size="13" fill="#56695E">Picaridin</text>
        <rect x="170" y="183" width="280" height="20" rx="4" fill="#C3D2C7"/><text x="444" y="197" text-anchor="end" font-size="12.5" font-weight="700" fill="#56695E">65%</text>
        <text x="162" y="230" text-anchor="end" font-size="13" fill="#56695E">Permethrin</text>
        <rect x="170" y="217" width="252" height="20" rx="4" fill="#C3D2C7"/><text x="416" y="231" text-anchor="end" font-size="12.5" font-weight="700" fill="#56695E">58%</text>
